{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tailwind": "tailwindcss -i ./src/styles.css -o ./src/styles.generated.css",
    "prebuild": "node scripts/generate-version.js && node scripts/generate-sitemap.mjs && tailwindcss -i ./src/styles.css -o ./src/styles.generated.css",
    "start": "node scripts/generate-version.js && node scripts/generate-sitemap.mjs && tailwindcss -i ./src/styles.css -o ./src/styles.generated.css && ng serve",
    "build": "node scripts/generate-version.js && node scripts/generate-sitemap.mjs && tailwindcss -i ./src/styles.css -o ./src/styles.generated.css && ng build",
    "watch": "node scripts/generate-version.js && ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.24",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.6.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
