      "destination": "/book.html"
    },
    {
      "source": "/primary/",
      "destination": "/primary.html"
    },
    {
      "source": "/primary",
      "destination": "/primary.html"
    },
    {
      "source": "/junior/",
      "destination": "/junior.html"
    },
    {
      "source": "/junior",
      "destination": "/junior.html"
    },
    {
      "source": "/senior/",
      "destination": "/senior.html"
    },
    {
      "source": "/senior",
      "destination": "/senior.html"
    },
    {
      "source": "/cert/",
      "destination": "/cert.html"
    },
    {
      "source": "/cert",
      "destination": "/cert.html"
    },
    {
      "source": "/exam/",
      "destination": "/exam.html"
    },
    {
      "source": "/exam",
