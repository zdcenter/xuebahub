---
import ChannelPage from '../components/ChannelPage.astro';

// SEO 301 权威规范重定向：将携带旧参数 ?channel=xxx 的请求永久重定向到静态目录 /xxx
const url = new URL(Astro.request.url);
const channelQuery = url.searchParams.get('channel');
if (channelQuery && channelQuery !== 'all') {
  url.searchParams.delete('channel');
  const remaining = url.searchParams.toString();
  const targetPath = `/${channelQuery}${remaining ? '?' + remaining : ''}`;
  return Astro.redirect(targetPath, 301);
}
---
<ChannelPage channelSlug="all" />
