---
import ChannelPage from '../components/ChannelPage.astro';

const { channel } = Astro.params;

// 过滤非频道形式的请求（如静态资源或无意义探测）
if (!channel || channel === 'favicon.ico' || channel.includes('.')) {
  return new Response(null, { status: 404 });
}

// 检查该频道是否在后台上线列表中，若已隐藏或下线则直接 302 重定向到首页
try {
  const chRes = await fetch('http://127.0.0.1:8080/api/v1/public/channels', { signal: AbortSignal.timeout(2000) });
  if (chRes.ok) {
    const chJson = await chRes.json();
    const rawList = Array.isArray(chJson.data) ? chJson.data : (chJson.data?.items || []);
    const activeChannels = rawList.map((c: any) => c.slug);
    if (!activeChannels.includes(channel)) {
      return Astro.redirect('/', 302);
    }
  }
} catch (e) {}
---
<ChannelPage channelSlug={channel} />
