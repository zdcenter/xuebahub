---
import Layout from '../../layouts/Layout.astro';
import { getApiBaseUrl } from '../../lib/api';
import QRCode from 'qrcode';

const { slug } = Astro.params;
const apiBase = getApiBaseUrl(Astro.url);

// 方案一：Cloudflare 边缘 CDN 极速缓存与后台静默刷新 (每个详情页独立缓存)
// max-age=60 (浏览器端缓存 1 分钟)
// s-maxage=300 (Cloudflare 边缘节点新鲜期 5 分钟，全国各节点秒开直出)
// stale-while-revalidate=86400 (过期后 24 小时内后台静默异步刷新，用户永不等待卡顿)
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=86400'
);

// 从 Go API 获取详情
let resource: any = null;
try {
  const resp = await fetch(`${apiBase}/api/v1/public/resources/${slug}`, { signal: AbortSignal.timeout(6000) });
  if (resp.ok) {
    const json = await resp.json();
    const data = json.data;
    if (data) {
      let previewImgs: Array<{ title: string; url: string }> = [];
      if (Array.isArray(data.preview_images) && data.preview_images.length > 0) {
        previewImgs = data.preview_images.map((img: any, idx: number) => {
          if (typeof img === 'string') {
            return { title: `资料预览节选第 ${idx + 1} 页`, url: img };
          }
          return { title: img.title || `资料预览第 ${idx + 1} 页`, url: img.url };
        });
      }

      resource = {
        id: data.id,
        slug: data.slug || slug,
        title: data.title,
        subtitle: data.subtitle,
        description: data.description || '',
        stage: data.stage,
        grade: data.grade,
        subject: data.subject,
        edition: data.edition,
        region: data.region || '',
        school: data.school || '',
        fileType: data.file_type || "PDF",
        fileSize: data.file_size || "15 MB",
        pageCount: data.page_count || 20,
        viewCount: data.view_count ?? 0,
        saveCount: data.save_count ?? 0,
        createdAt: data.created_at ? data.created_at.substring(0, 10) : "2026-04-01",
        previewImages: previewImgs,
        fileTree: Array.isArray(data.file_tree) ? data.file_tree : [],
        links: (data.links || []).map((l: any) => ({
          id: l.id,
          drive_type: l.drive_type,
          drive_name: l.drive_type === 'quark' ? '夸克网盘（极速推荐）' : '百度网盘（备用通道）',
          file_size: l.file_size || data.file_size || '15.0 MB',
          file_type: l.file_type || data.file_type || 'PDF',
          resource_desc: l.resource_desc || (l.drive_type === 'quark' ? '手机APP转存免下载，原画质在线看视频与打印' : '电脑端备用转存'),
          click_count: l.click_count ?? 0,
          updated_at: l.updated_at ? l.updated_at.substring(0, 10) : (data.created_at ? data.created_at.substring(0, 10) : '2026-10-04'),
          share_url: l.share_url,
          extract_code: l.extract_code,
          password_hint: l.password_hint || (l.extract_code ? `提取码：${l.extract_code}` : '无提取码'),
          is_primary: l.is_primary,
          status: l.status || 'active',
          invalid_reason: l.invalid_reason || ''
        }))
      };
    }
  }
} catch (e) {
  // 降级兜底
}

if (!resource) {
  resource = {
    id: "demo",
    slug: slug || "demo",
    title: "2026春季人教版三年级下册数学期末冲刺夺冠押题卷（含高清解析与手写步骤）",
    subtitle: "名校名师联合精选必考压轴题，覆盖乘除法、面积计算、小数初步",
    description: "本套试卷专为三年级下册期末复习研发，包含3套名校期末全真模拟密卷及1套名师压轴重点突破卷。试卷排版严格按照标准 A4 试卷规格设计，配有答题卡、手撕解析与解题思路大纲。全部题目均配有名师手写解答，适合家长为孩子打印冲刺满分使用。",
    stage: "小学阶段",
    grade: "三年级",
    subject: "数学",
    edition: "人教版统编教材",
    fileType: "PDF 清晰可打印版",
    fileSize: "12.4 MB",
    pageCount: 28,
    viewCount: 0,
    saveCount: 0,
    createdAt: "2026-03-28",
    previewImages: [],
    fileTree: [],
    links: [
      {
        id: "demo-quark",
        drive_type: "quark",
        drive_name: "夸克网盘（极速推荐）",
        desc: "手机APP转存免下载，在线高清直接查看与PDF打印",
        file_size: "12.4 MB",
        file_type: "PDF清晰可打印版",
        resource_desc: "手机APP转存免下载，原画质在线看视频与打印",
        click_count: 380,
        updated_at: "2026-10-04",
        share_url: "https://pan.quark.cn/s/demo_quark_share",
        extract_code: "",
        password_hint: "无提取码，一键转存",
        is_primary: true
      }
    ]
  };
}

if (resource && Array.isArray(resource.links)) {
  for (const link of resource.links) {
    if (link.share_url) {
      try {
        link.qr_svg = await QRCode.toString(link.share_url, {
          type: 'svg',
          margin: 1,
          width: 200,
          color: {
            dark: '#0f172a',
            light: '#ffffff'
          }
        });
      } catch (err) {
        link.qr_svg = '';
      }
    }
  }
}

// 生成本页面专属分享二维码与标准推荐口令
let pageShareQrSvg = '';
const canonicalPageUrl = `${Astro.url.origin}/resource/${resource.slug}`;
try {
  pageShareQrSvg = await QRCode.toString(canonicalPageUrl, {
    type: 'svg',
    margin: 1,
    width: 200,
    color: {
      dark: '#1e40af',
      light: '#ffffff'
    }
  });
} catch (e) {
  pageShareQrSvg = '';
}

const shareRecommendationText = `【学霸网资料推荐】《${resource.title}》\n📁 规格：${resource.grade} ${resource.subject} · ${resource.fileType}\n✨ 特色：${resource.subtitle || '名校高清排版，支持直接A4打印冲刺高分'}\n⚡ 点击直达极速转存与下载：\n${canonicalPageUrl}`;

function normalizeFileTree(list: any[]): any[] {
  if (!list || !Array.isArray(list)) return [];
  if (list.some((it: any) => it.children && it.children.length > 0)) {
    return list;
  }
  const hasSlash = list.some((it: any) => it.name && it.name.includes('/'));
  if (!hasSlash) return list;

  const folderMap = new Map<string, any>();
  const rootItems: any[] = [];

  for (const item of list) {
    if (item.name && item.name.includes('/')) {
      const parts = item.name.split('/');
      const folderName = parts[0];
      const fileName = parts.slice(1).join('/');
      if (!folderMap.has(folderName)) {
        folderMap.set(folderName, {
          name: folderName,
          is_dir: true,
          ext: 'DIR',
          size: '',
          children: []
        });
      }
      folderMap.get(folderName).children.push({
        ...item,
        name: fileName
      });
    } else {
      rootItems.push(item);
    }
  }

  const result = [...rootItems];
  for (const folder of folderMap.values()) {
    folder.size = `${folder.children.length} 个文件`;
    result.push(folder);
  }
  return result;
}

function countTotalFiles(list: any[]): number {
  if (!list || !Array.isArray(list)) return 0;
  let count = 0;
  for (const item of list) {
    if (item.is_dir && item.children && item.children.length > 0) {
      count += item.children.length;
    } else {
      count++;
    }
  }
  return count;
}

function getFileIcon(ext: string, isDir?: boolean): string {
  if (isDir) return '📁';
  const e = (ext || '').toUpperCase();
  if (['MP4', 'MKV', 'AVI', 'MOV', 'FLV', 'TS'].includes(e)) return '🎬';
  if (['PDF'].includes(e)) return '📄';
  if (['DOC', 'DOCX', 'TXT', 'WPS'].includes(e)) return '📝';
  if (['PPT', 'PPTX'].includes(e)) return '📑';
  if (['XLS', 'XLSX', 'CSV'].includes(e)) return '📊';
  if (['ZIP', 'RAR', '7Z', 'TAR', 'GZ'].includes(e)) return '📦';
  if (['MP3', 'WAV', 'FLAC', 'AAC', 'M4A'].includes(e)) return '🎵';
  if (['JPG', 'JPEG', 'PNG', 'WEBP', 'GIF'].includes(e)) return '🖼️';
  return '📄';
}

function getFileBadgeClass(ext: string): string {
  const e = (ext || '').toUpperCase();
  if (['MP4', 'MKV', 'AVI', 'MOV', 'FLV', 'TS'].includes(e)) return 'bg-purple-50 text-purple-700 border-purple-200';
  if (['PDF'].includes(e)) return 'bg-rose-50 text-rose-700 border-rose-200';
  if (['DOC', 'DOCX', 'TXT', 'WPS'].includes(e)) return 'bg-blue-50 text-blue-700 border-blue-200';
  if (['PPT', 'PPTX'].includes(e)) return 'bg-amber-50 text-amber-700 border-amber-200';
  if (['XLS', 'XLSX', 'CSV'].includes(e)) return 'bg-emerald-50 text-emerald-700 border-emerald-200';
  if (['ZIP', 'RAR', '7Z', 'TAR'].includes(e)) return 'bg-orange-50 text-orange-700 border-orange-200';
  if (['MP3', 'WAV', 'FLAC'].includes(e)) return 'bg-teal-50 text-teal-700 border-teal-200';
  if (['JPG', 'JPEG', 'PNG', 'WEBP'].includes(e)) return 'bg-indigo-50 text-indigo-700 border-indigo-200';
  return 'bg-slate-100 text-slate-600 border-slate-200';
}

const displayTree = normalizeFileTree(resource.fileTree);
const totalFileCount = countTotalFiles(resource.fileTree);

const STAGE_LABELS: Record<string, string> = {
  primary: '小学',
  junior: '初中',
  senior: '高中',
  cert: '资格考证',
  exam: '公考升学'
};
const stageLabel = STAGE_LABELS[resource.stage] || resource.stage || '资料专区';
const stageHref = STAGE_LABELS[resource.stage] ? `/${resource.stage}` : '/edu';
// 自动判定分享缩略图优先级：用户指定封面 > Cloudflare R2 极速对象存储图片 > 官方通用兜底图
const imageBase = import.meta.env.PUBLIC_IMAGE_URL || 'https://image.xuebaw.com';
const resourceCoverUrl = resource.coverUrl || `${imageBase}/covers/${resource.slug}.png`;
---

<Layout
  title={`${resource.title} - 学霸网`}
  description={resource.subtitle}
  keywords={`${resource.grade}, ${resource.subject}, ${resource.edition}, 期末试卷, 试卷下载`}
  canonicalUrl={canonicalPageUrl}
  image={resourceCoverUrl}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8" id="resource-container" data-api-base={apiBase}>
    <!-- 面包屑导航 -->
    <nav class="flex items-center space-x-2 text-xs text-slate-500">
      <a href="/" class="hover:text-blue-600">首页</a>
      <span>/</span>
      <a href={stageHref} class="hover:text-blue-600">{stageLabel}</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{resource.grade} {resource.subject}</span>
    </nav>

    <!-- 主体内容区：卡片式无缝结合 -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      
      <!-- 顶部：资料元信息 -->
      <div class="p-5 sm:p-6 lg:p-8 border-b border-slate-100 bg-gradient-to-br from-white to-slate-50/50">
        <div class="flex flex-wrap items-center gap-2 mb-6">
          <span class="px-2.5 py-1 bg-blue-100 text-blue-700 font-bold text-xs rounded-lg">{resource.grade}</span>
          <span class="px-2.5 py-1 bg-indigo-100 text-indigo-700 font-bold text-xs rounded-lg">{resource.subject}</span>
          <span class="px-2.5 py-1 bg-slate-100 text-slate-700 font-medium text-xs rounded-lg">{resource.edition}</span>
          {resource.school && (
            <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 border border-indigo-200 font-bold text-xs rounded-lg flex items-center gap-1">
              <span>🏫</span><span>{resource.school}</span>
            </span>
          )}
          {resource.region && !resource.school && (
            <span class="px-2.5 py-1 bg-sky-50 text-sky-700 border border-sky-200 font-medium text-xs rounded-lg flex items-center gap-1">
              <span>📍</span><span>{resource.region}</span>
            </span>
          )}
          <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 font-medium text-xs rounded-lg">官方完整版 · 纯净无水印</span>
        </div>

        <div class="space-y-3">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 leading-snug tracking-tight">
            {resource.title}
          </h1>
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <div class="flex-1">
              {resource.subtitle && (
                <h2 class="text-sm sm:text-base font-medium text-slate-400/90 tracking-wide">
                  {resource.subtitle}
                </h2>
              )}
            </div>
            
            <div class="flex flex-wrap items-center sm:justify-end gap-2.5 sm:gap-3 text-xs">
              <span class="text-slate-400 flex items-center space-x-1.5">
                <span>📅</span>
                <span class="font-medium text-slate-500">{resource.createdAt}</span>
              </span>
              <span class="text-slate-200 hidden sm:inline">•</span>
              <span class="text-slate-400 flex items-center space-x-1.5">
                <span>👁️</span>
                <span class="font-mono font-medium text-slate-500">{resource.viewCount} 次浏览</span>
              </span>
              <!-- 醒目顶部分享推荐按钮 (直通扫码与一键推荐) -->
              <button
                type="button"
                id="btn-header-share"
                class="btn-trigger-share ml-1 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 hover:from-blue-700 hover:to-indigo-800 active:scale-95 text-white font-bold text-xs shadow-sm hover:shadow-md hover:scale-[1.03] transition-all flex items-center gap-1.5 cursor-pointer select-none"
                title="分享资料、微信扫码或推荐给家长/考友群"
              >
                <span>🎁</span>
                <span>分享推荐</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 中部：网盘转存下载（一目了然的极简列表） -->
      <div class="p-5 sm:p-6 lg:p-8 bg-slate-50/50">
        <!-- 警示横幅 -->
        {resource.links.some((l: any) => l.status === 'invalid') && (
          <div class="mb-5 p-3.5 bg-amber-50 border border-amber-200 rounded-xl flex items-center text-xs text-amber-900">
            <span class="text-base mr-2">⚠️</span>
            <span>检测到部分网盘已失效，站长已安排补链。请优先选择标记为<strong>【✅ 正常存活】</strong>的可用网盘极速转存！</span>
          </div>
        )}

        <div class="grid grid-cols-1 gap-4">
          {resource.links.map((link: any) => (
            <div class={`flex flex-col lg:flex-row lg:items-center justify-between p-4 sm:p-5 rounded-2xl border transition-all gap-4 ${
              link.status === 'invalid'
                ? 'bg-rose-50/40 border-rose-200 opacity-80'
                : link.is_primary 
                  ? 'bg-white border-blue-300 shadow-sm ring-1 ring-blue-50' 
                  : 'bg-white border-slate-200 shadow-sm hover:border-blue-200'
            }`}>
              <div class="flex items-start sm:items-center gap-3.5 sm:gap-4 flex-1 min-w-0">
                <div class={`flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center text-2xl shadow-inner border mt-0.5 sm:mt-0 ${
                  link.drive_name.includes('夸克') ? 'bg-blue-50 border-blue-100 text-blue-500' : 
                  link.drive_name.includes('百度') ? 'bg-sky-50 border-sky-100 text-sky-500' : 
                  'bg-indigo-50 border-indigo-100 text-indigo-500'
