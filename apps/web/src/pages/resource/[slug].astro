                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="font-bold text-slate-800 text-base truncate">{link.drive_name}</h3>
                    {link.is_primary && link.status !== 'invalid' && (
                      <span class="bg-blue-600 text-white text-[10px] px-2 py-0.5 rounded-md font-bold flex-shrink-0">主推极速</span>
                    )}
                    {link.status === 'invalid' && (
                      <span class="bg-rose-100 text-rose-700 text-[10px] px-2 py-0.5 rounded-md font-bold border border-rose-200 flex-shrink-0">失效补链中</span>
                    )}
                  </div>
                  <div class="text-xs text-slate-500 mt-1 flex flex-wrap items-center gap-2">
                    <span>{(!link.file_size || link.file_size === '0 B') ? ((resource.fileSize && resource.fileSize !== '0 B') ? resource.fileSize : '完整视频合集包') : link.file_size}</span>
                    <span class="text-slate-300">•</span>
                    <span>{link.file_type}</span>
                    {link.extract_code && (
                      <>
                        <span class="text-slate-300">•</span>
                        <span class="text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded font-mono border border-amber-100">密码: {link.extract_code}</span>
                      </>
                    )}
                    <span class="text-slate-300">•</span>
                    <span class="flex items-center gap-1">⚡ <span id={`link-count-${link.id}`}>{link.click_count}</span> 人已转存</span>
                  </div>

                  <!-- 明文网盘真实地址栏 (透明公开真实网盘URL，支持直达与一键复制) -->
                  {link.share_url && (
                    <div class="mt-2.5 flex items-center gap-2 bg-slate-50/90 hover:bg-slate-100/80 border border-slate-200/80 rounded-xl px-2.5 sm:px-3 py-1.5 text-xs transition">
                      <span class="text-slate-400 font-medium shrink-0 flex items-center gap-1">
                        <span>🔗</span>
                        <span class="hidden sm:inline">网盘地址:</span>
                      </span>
                      <a
                        href={link.share_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-600 hover:text-blue-800 font-mono text-xs truncate flex-1 hover:underline select-all"
                        title={`直接打开网盘链接: ${link.share_url}`}
                      >
                        {link.share_url}
                      </a>
                      <button
                        type="button"
                        class="btn-copy-raw-link px-2 py-0.5 text-slate-500 hover:text-blue-600 bg-white hover:bg-blue-50 border border-slate-200/80 hover:border-blue-200 rounded-lg transition shrink-0 cursor-pointer flex items-center gap-1 text-[11px] font-medium shadow-2xs"
                        data-url={link.share_url}
                        data-pwd={link.extract_code || ''}
                        title="复制网盘链接与提取码"
                      >
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                        </svg>
                        <span>复制</span>
                      </button>
                    </div>
                  )}
                </div>
              </div>

              <div class="flex flex-row items-center justify-end gap-3 w-full lg:w-auto pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-100 relative shrink-0">
                <!-- 电脑端悬浮放大二维码 -->
                {link.qr_svg && link.status !== 'invalid' && (
                  <div class="hidden md:flex items-center justify-center w-12 h-12 p-0.5 border border-slate-200 rounded-lg hover:scale-[4] transition-transform origin-right bg-white shadow-xs cursor-crosshair z-20 [&>svg]:w-full [&>svg]:h-full" set:html={link.qr_svg} title="鼠标悬浮放大，微信/网盘直接扫码保存"></div>
                )}
                
                {link.status === 'invalid' ? (
                  <button disabled class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-sm bg-slate-100 text-slate-400 cursor-not-allowed">
                    暂不可用
                  </button>
                ) : (
                  <a href={link.share_url} target="_blank" rel="noopener noreferrer" class={`btn-track-save w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-sm text-center transition flex-shrink-0 flex items-center justify-center space-x-1 ${link.is_primary ? 'bg-blue-600 hover:bg-blue-700 text-white shadow-md' : 'bg-slate-800 hover:bg-slate-900 text-white shadow-sm'}`} data-slug={resource.slug} data-link-id={link.id || ''}>
                    <span>立即转存下载</span>
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>


      <!-- 底部：资源内含文件清单 -->
      {resource.fileTree && resource.fileTree.length > 0 && (
        <div class="p-5 sm:p-6 lg:p-8 border-t border-slate-100 space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-slate-900 flex items-center space-x-2">
                <span class="p-1.5 bg-blue-100 text-blue-700 rounded-xl">📂</span>
                <span>网盘内含文件清单与目录结构</span>
                <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                  真实层级 · 所见即所得
                </span>
              </h3>
            </div>
            
            <div class="flex items-center space-x-2 text-xs font-semibold text-slate-600 bg-white/95 px-3.5 py-1.5 rounded-xl border border-blue-100 shadow-xs shrink-0">
