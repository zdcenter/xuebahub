        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {resource.previewImages.map((img: any) => (
            <div class="space-y-2">
              <div class="aspect-[3/4] bg-slate-100 rounded-2xl overflow-hidden border border-slate-200 shadow-sm group">
                <img
                  src={img.url}
                  alt={img.title}
                  class="w-full h-full object-cover group-hover:scale-102 transition"
                  loading="lazy"
                />
              </div>
              <p class="text-xs text-slate-600 text-center font-medium">
                {img.title}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}


  </div>

  <!-- 轻量复制反馈 Toast -->
  <div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 bg-slate-900/90 backdrop-blur-md text-white text-xs font-semibold rounded-2xl shadow-xl transition-all duration-300 opacity-0 pointer-events-none translate-y-3">
    📋 链接已成功复制到剪贴板！
  </div>

  <!-- 客户端交互脚本：复制链接与实时上报转存统计 -->
  <script is:inline>
    function showToast(text) {
      const toast = document.getElementById('copy-toast');
      if (!toast) return;
      toast.innerText = text;
      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
      }, 2000);
    }

    function recordSaveClick(slug, linkId) {
      if (!slug) return;
      var host = window.location.hostname || '127.0.0.1';
      var isLocal = (host === 'localhost' || host === '127.0.0.1');
      var base = isLocal 
        ? ('http://' + host + ':4001') 
        : ((container && container.getAttribute('data-api-base')) || 'https://api.xuebaw.com:8443');
      var apiUrl = base + '/api/v1/public/resources/' + encodeURIComponent(slug) + '/track-save';
      if (linkId) {
        apiUrl += '?link_id=' + encodeURIComponent(linkId);
      }

      fetch(apiUrl, {
        method: 'POST',
        mode: 'cors',
        headers: { 'Content-Type': 'application/json' }
      })
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (json && json.data) {
            if (typeof json.data.save_count === 'number') {
              var el = document.getElementById('save-count-display');
              if (el) el.innerText = String(json.data.save_count);
            }
            if (linkId && typeof json.data.link_click === 'number') {
              var linkEl = document.getElementById('link-count-' + linkId);
              if (linkEl) linkEl.innerText = String(json.data.link_click);
            }
          }
        })
        .catch(function(err) {
          console.warn('Track save error:', err);
        });
    }

    // 绑定复制按钮
    document.querySelectorAll('.btn-copy-url').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const url = btn.getAttribute('data-url');
        const code = btn.getAttribute('data-code');
        const slug = btn.getAttribute('data-slug');
        const linkId = btn.getAttribute('data-link-id');
        if (!url) return;

        let copyText = url;
        if (code) {
          copyText += ' 提取码: ' + code;
        }

        navigator.clipboard.writeText(copyText).then(() => {
          showToast('📋 网盘链接已复制到剪贴板！');
          recordSaveClick(slug, linkId);
        }).catch(() => {
          prompt('请手动长按复制网盘链接：', copyText);
        });
      });
    });

    // 绑定转存按钮，点击时实时累加计数
    document.querySelectorAll('.btn-track-save').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        const linkId = btn.getAttribute('data-link-id');
        recordSaveClick(slug, linkId);
      });
    });

    // 绑定单一提取码复制按钮
    document.querySelectorAll('.btn-copy-code').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const code = btn.getAttribute('data-code');
        if (!code) return;
        navigator.clipboard.writeText(code).then(() => {
          showToast('📋 提取码已复制！');
        }).catch(() => {
          prompt('请手动复制提取码：', code);
        });
      });
    });

    // 绑定网盘失效报错按钮
    document.querySelectorAll('.btn-report-link').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const linkId = btn.getAttribute('data-link-id');
        if (!linkId || linkId.startsWith('demo')) {
          showToast('⚠️ 示例链接暂不支持报错反馈');
          return;
        }
        const reportedKey = 'reported_link_' + linkId;
        if (localStorage.getItem(reportedKey)) {
          showToast('ℹ️ 您已提交过该链接的失效反馈，管理员正在核实处理！');
          return;
        }

        if (!confirm('确定该网盘链接已失效、被取消或无法打开？我们将安排管理员复核补链。')) {
          return;
        }

        btn.setAttribute('disabled', 'true');
        btn.classList.add('opacity-50', 'cursor-not-allowed');

        const host = window.location.hostname || '127.0.0.1';
        const isLocal = (host === 'localhost' || host === '127.0.0.1');
        const apiBaseUrl = isLocal 
          ? `http://${host}:4001` 
          : (document.getElementById('resource-container')?.getAttribute('data-api-base') || 'https://api.xuebaw.com:8443');

        fetch(`${apiBaseUrl}/api/v1/public/links/${linkId}/report`, {
          method: 'POST',
          mode: 'cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: '前台用户一键报错' })
        })
          .then(res => res.json())
          .then(data => {
            localStorage.setItem(reportedKey, 'true');
            showToast('✅ 报错已提交！感谢反馈，我们将尽快修复或补充备用盘');
            btn.innerHTML = '<span>✅ 已反馈</span>';
          })
          .catch(err => {
            showToast('网络繁忙，请稍后再试');
            btn.removeAttribute('disabled');
            btn.classList.remove('opacity-50', 'cursor-not-allowed');
          });
      });
    });

    // 绑定资源管理器风格目录树折叠/展开交互
    const dirHeaders = document.querySelectorAll('.tree-dir-header');
    dirHeaders.forEach(header => {
      header.addEventListener('click', () => {
        const parent = header.closest('.tree-dir-item');
        if (!parent) return;
        const body = parent.querySelector('.tree-dir-body');
        const caret = parent.querySelector('.tree-caret');
        if (body) {
          const isHidden = body.classList.contains('hidden');
          if (isHidden) {
            body.classList.remove('hidden');
            if (caret) caret.textContent = '▼';
          } else {
            body.classList.add('hidden');
            if (caret) caret.textContent = '▶';
          }
        }
      });
    });

    // 绑定“全部展开 / 全部折叠”全局按钮
    const toggleAllBtn = document.getElementById('btn-toggle-all-folders');
    let allExpanded = true;
    if (toggleAllBtn) {
      toggleAllBtn.addEventListener('click', () => {
        allExpanded = !allExpanded;
        const allBodies = document.querySelectorAll('.tree-dir-body');
        const allCarets = document.querySelectorAll('.tree-caret');
        allBodies.forEach(b => {
          if (allExpanded) {
            b.classList.remove('hidden');
          } else {
            b.classList.add('hidden');
          }
        });
        allCarets.forEach(c => {
          c.textContent = allExpanded ? '▼' : '▶';
        });
        const toggleAllText = document.getElementById('btn-toggle-all-text');
        if (toggleAllText) {
          toggleAllText.textContent = allExpanded ? '全部折叠' : '全部展开';
        }
      });
    }
  </script>

  <!-- 专属高颜值分享与推荐弹窗 (Share Modal) -->
  <div id="share-modal-backdrop" class="fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200 flex items-center justify-center p-4">
    <div id="share-modal-panel" class="bg-white rounded-3xl max-w-md w-full shadow-2xl border border-slate-100 overflow-hidden transform scale-95 opacity-0 transition-all duration-200">
      <!-- 弹窗顶部 -->
      <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-blue-50/50 to-indigo-50/30">
        <div class="flex items-center space-x-2.5">
          <img src="/logo.svg" alt="学霸网" class="w-8 h-8 rounded-xl shadow-sm" />
          <div>
            <div class="font-extrabold text-slate-900 text-sm">分享推荐此资料</div>
            <div class="text-[10px] text-slate-400">学霸网 · 专业的网盘学习与备考资源站</div>
          </div>
        </div>
        <button id="btn-close-share-modal" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-xl transition cursor-pointer" title="关闭">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="p-5 sm:p-6 space-y-4">
        <!-- 资料信息摘要 -->
        <div class="p-3 bg-slate-50 rounded-2xl border border-slate-100 space-y-1">
          <div class="flex items-center gap-1.5 text-[11px]">
            <span class="px-2 py-0.5 bg-blue-100 text-blue-700 font-bold rounded">{resource.grade} {resource.subject}</span>
            <span class="text-slate-400 font-mono">{resource.fileType}</span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-slate-800 line-clamp-2 leading-snug">
            {resource.title}
          </h4>
        </div>

        <!-- 手机扫码与推荐语双模式 -->
        <div class="flex flex-col sm:flex-row items-center gap-4 bg-blue-50/40 rounded-2xl p-4 border border-blue-100/60">
          <!-- 手机微信扫码直达二维码 -->
          {pageShareQrSvg && (
            <div class="flex-shrink-0 flex flex-col items-center">
              <div class="w-24 h-24 sm:w-28 sm:h-28 bg-white p-1 rounded-xl shadow-xs border border-blue-100 [&>svg]:w-full [&>svg]:h-full" set:html={pageShareQrSvg}></div>
              <span class="text-[10px] text-blue-700 font-bold mt-1.5 flex items-center gap-0.5">
                <span>📱</span><span>微信扫码直达</span>
              </span>
            </div>
          )}
          <div class="flex-1 text-xs text-slate-600 space-y-2 text-center sm:text-left">
            <div class="font-bold text-slate-800 flex items-center justify-center sm:justify-start gap-1">
              <span>💬</span><span>推荐方式：</span>
            </div>
            <p class="text-[11px] text-slate-500 leading-relaxed">
              手机打开微信【扫一扫】直接浏览并转存，或点击下方按钮复制完整推荐语，直接粘贴至<strong>微信群、朋友圈、QQ群</strong>。
            </p>
          </div>
        </div>

        <!-- 推荐文案预览框 -->
        <div class="relative">
          <textarea
            id="share-text-box"
            readonly
            class="w-full h-20 p-2.5 text-xs font-mono bg-slate-50 border border-slate-200 rounded-xl text-slate-600 resize-none outline-none leading-relaxed"
          >{shareRecommendationText}</textarea>
        </div>

        <!-- 移动端系统原生分享按钮 (仅在支持的环境显示) -->
        <button
          type="button"
          id="btn-native-share"
          class="hidden w-full py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-xs rounded-xl shadow-sm transition text-center cursor-pointer items-center justify-center gap-1.5"
        >
          <span>📲</span><span>唤起手机系统分享 (直发微信好友/群)</span>
        </button>

        <!-- 按钮行动组 -->
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="btn-copy-link-only"
            class="flex-1 py-2.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 font-bold text-xs rounded-xl shadow-2xs transition text-center cursor-pointer"
          >
            仅复制网页链接
          </button>
          <button
            type="button"
            id="btn-copy-full-text"
            class="flex-1 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-md shadow-blue-500/20 transition text-center cursor-pointer"
          >
            一键复制推荐全文
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // 分享推荐弹窗总控逻辑
    function openShareModal() {
      var backdrop = document.getElementById('share-modal-backdrop');
      var panel = document.getElementById('share-modal-panel');
      if (backdrop && panel) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        panel.classList.remove('scale-95', 'opacity-0');
        panel.classList.add('scale-100', 'opacity-100');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeShareModal() {
      var backdrop = document.getElementById('share-modal-backdrop');
      var panel = document.getElementById('share-modal-panel');
      if (backdrop && panel) {
        panel.classList.remove('scale-100', 'opacity-100');
        panel.classList.add('scale-95', 'opacity-0');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    }

    function copyToClipboard(text, successMsg, btnElement, successBtnText) {
      function onSuccess() {
        if (window.showGlobalToast) {
          window.showGlobalToast(successMsg, '🎉');
        } else if (typeof showToast === 'function') {
          showToast(successMsg);
        } else {
          alert(successMsg);
        }
        if (btnElement && successBtnText) {
          var origHtml = btnElement.innerHTML;
          btnElement.innerHTML = '✓ ' + successBtnText;
          btnElement.classList.add('bg-emerald-600', 'text-white');
          setTimeout(function() {
            btnElement.innerHTML = origHtml;
            btnElement.classList.remove('bg-emerald-600', 'text-white');
          }, 2000);
        }
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(onSuccess).catch(function() {
          fallbackCopy(text, onSuccess);
        });
      } else {
        fallbackCopy(text, onSuccess);
      }
    }

    function fallbackCopy(text, onSuccess) {
      var textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      textArea.style.left = "-9999px";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try {
        var successful = document.execCommand('copy');
        if (successful) {
          onSuccess();
        } else {
          if (window.showGlobalToast) window.showGlobalToast('已选中，请按 Ctrl+C 复制', '📋');
        }
      } catch (err) {
        if (window.showGlobalToast) window.showGlobalToast('已选中，请按 Ctrl+C 复制', '📋');
      }
      document.body.removeChild(textArea);
    }

    // 检查是否显示系统原生分享按钮
    if (typeof navigator !== 'undefined' && navigator.share) {
      var nativeBtn = document.getElementById('btn-native-share');
      if (nativeBtn) {
        nativeBtn.classList.remove('hidden');
        nativeBtn.classList.add('flex');
      }
    }

    // 全局事件委托监听：保证无论元素渲染时机如何，100% 捕获点击！
    document.addEventListener('click', function(e) {
      var target = e.target;
      if (!target) return;

      // 1. 点击“分享推荐”按钮
      var shareTrigger = target.closest('#btn-header-share, .btn-trigger-share');
      if (shareTrigger) {
        e.preventDefault();
        e.stopPropagation();
        openShareModal();
        return;
      }

      // 2. 点击关闭弹窗按钮
      var closeBtn = target.closest('#btn-close-share-modal');
      if (closeBtn) {
        e.preventDefault();
        closeShareModal();
        return;
      }

      // 3. 点击遮罩背景关闭
      var backdrop = document.getElementById('share-modal-backdrop');
      if (target === backdrop) {
        e.preventDefault();
        closeShareModal();
        return;
      }

      // 4. 点击一键复制推荐全文
      var copyFullBtn = target.closest('#btn-copy-full-text');
      if (copyFullBtn) {
        e.preventDefault();
        var textBox = document.getElementById('share-text-box');
        var text = (textBox && textBox.value) ? textBox.value : window.location.href;
        copyToClipboard(text, '推荐全文与专属链接已复制！去微信/QQ粘贴即可分享', copyFullBtn, '已复制全文');
        return;
      }

      // 5. 点击仅复制网页链接
      var copyLinkBtn = target.closest('#btn-copy-link-only');
      if (copyLinkBtn) {
        e.preventDefault();
        copyToClipboard(window.location.href, '网页直达链接已复制！', copyLinkBtn, '已复制链接');
        return;
      }

      // 6. 点击原生分享
      var nativeShareBtn = target.closest('#btn-native-share');
      if (nativeShareBtn) {
        e.preventDefault();
        if (navigator.share) {
          var textBox2 = document.getElementById('share-text-box');
          navigator.share({
            title: document.title,
            text: (textBox2 && textBox2.value) ? textBox2.value : document.title,
            url: window.location.href
          }).catch(function() {});
        }
        return;
      }

      // 7. 点击复制真实网盘地址与提取码
      var copyRawBtn = target.closest('.btn-copy-raw-link');
      if (copyRawBtn) {
        e.preventDefault();
        e.stopPropagation();
        var rawUrl = copyRawBtn.getAttribute('data-url') || '';
        var rawPwd = copyRawBtn.getAttribute('data-pwd') || '';
        var copyPayload = rawPwd ? ('链接: ' + rawUrl + ' 提取码: ' + rawPwd) : rawUrl;
        copyToClipboard(copyPayload, '网盘地址' + (rawPwd ? '及提取码' : '') + '已成功复制！', copyRawBtn, '已复制');
        return;
      }
    });

    // ESC 键关闭弹窗
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeShareModal();
      }
    });
  </script>
</Layout>
