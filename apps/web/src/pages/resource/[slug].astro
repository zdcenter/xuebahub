              </div>
            </div>

            <!-- 资源管理器列名条 (类似 Windows/网盘 详情视图) -->
            <div class="bg-slate-100/70 border-b border-slate-200/60 px-4 py-1.5 flex items-center justify-between text-[11px] font-medium text-slate-400 select-none">
              <span class="flex-1 min-w-0 pl-1">文件名</span>
              <span class="w-24 text-right pr-2 shrink-0">大小</span>
            </div>

            <!-- 树形文件列表体 -->
            <div class="divide-y divide-slate-100 text-xs" id="file-tree-container">
              {displayTree.map((node: any, idx: number) => {
                if (node.is_dir) {
                  const children = node.children || [];
                  return (
                    <div class="tree-dir-item group" data-dir-index={idx}>
                      <!-- 文件夹行 (可点击折叠/展开) -->
                      <div class="tree-dir-header flex items-center justify-between px-3.5 py-2.5 bg-slate-50/50 hover:bg-blue-50/40 cursor-pointer transition select-none">
                        <div class="flex items-center space-x-2 min-w-0 flex-1">
                          <span class="tree-caret w-4 text-[10px] text-slate-400 group-hover:text-blue-600 transition-transform duration-200 inline-block text-center select-none font-mono">
                            ▼
                          </span>
                          <span class="text-base shrink-0">📁</span>
                          <span class="font-bold text-slate-800 group-hover:text-blue-700 truncate text-xs sm:text-sm" title={node.name}>
                            {node.name}
                          </span>
                        </div>
                        <div class="flex items-center space-x-2 shrink-0 pl-2">
                          <span class="text-[10px] font-mono text-slate-500 bg-white px-2 py-0.5 rounded-full border border-slate-200/80 shadow-2xs">
                            {node.size || `${children.length} 项`}
                          </span>
                        </div>
                      </div>

                      <!-- 文件夹嵌套子文件列表 (带专业树形连线与缩进) -->
                      {children.length > 0 && (
                        <div class="tree-dir-body bg-white py-1">
                          <div class="ml-5 sm:ml-7 pl-3 sm:pl-4 border-l-2 border-slate-200/90 space-y-0.5 my-1">
                            {children.map((child: any, cIdx: number) => {
                              const cExt = (child.ext || (child.name ? child.name.split('.').pop() : '')).toUpperCase();
                              const childIcon = getFileIcon(cExt, child.is_dir);
                              const badgeClass = getFileBadgeClass(cExt);

                              return (
                                <div class="relative flex items-center justify-between py-1.5 px-2 rounded-lg hover:bg-slate-50 transition group/file">
                                  <!-- 树状分支拐角连线 -->
                                  <span class="absolute -left-3 sm:-left-4 top-1/2 -mt-px w-2.5 sm:w-3.5 h-px bg-slate-200/90 pointer-events-none"></span>

                                  <div class="flex items-center space-x-2 min-w-0 flex-1">
                                    <span class="text-sm shrink-0">{childIcon}</span>
                                    <span class="font-medium text-slate-700 group-hover/file:text-blue-600 truncate text-xs" title={child.name}>
                                      {child.name}
                                    </span>
                                    {cExt && (
                                      <span class={`text-[9px] font-bold px-1.5 py-0.5 rounded border uppercase shrink-0 font-mono ${badgeClass}`}>
                                        {cExt}
                                      </span>
                                    )}
                                  </div>

                                  <div class="w-24 text-right pr-2 shrink-0">
                                    {child.size ? (
                                      <span class="text-[11px] font-mono text-slate-400 group-hover/file:text-slate-600">
                                        {child.size}
                                      </span>
                                    ) : (
                                      <span class="text-[10px] text-slate-300">-</span>
                                    )}
                                  </div>
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                    </div>
                  );
                }

                // 根目录下直接存放的文件 (顶层文件)
                const ext = (node.ext || (node.name ? node.name.split('.').pop() : '')).toUpperCase();
                const fileIcon = getFileIcon(ext, node.is_dir);
                const badgeClass = getFileBadgeClass(ext);

                return (
                  <div class="flex items-center justify-between px-3.5 py-2.5 hover:bg-blue-50/30 transition group/rootfile">
                    <div class="flex items-center space-x-2 min-w-0 flex-1">
                      <!-- 占位对齐图标 -->
                      <span class="w-4 inline-block text-center text-slate-300 select-none text-[10px]">·</span>
                      <span class="text-sm shrink-0">{fileIcon}</span>
                      <span class="font-medium text-slate-800 group-hover/rootfile:text-blue-600 truncate text-xs sm:text-sm" title={node.name}>
                        {node.name}
                      </span>
                      {ext && (
                        <span class={`text-[9px] font-bold px-1.5 py-0.5 rounded border uppercase shrink-0 font-mono ${badgeClass}`}>
                          {ext}
                        </span>
                      )}
                    </div>

                    <div class="w-24 text-right pr-2 shrink-0">
                      {node.size ? (
                        <span class="text-[11px] font-mono text-slate-400 group-hover/rootfile:text-slate-600">
                          {node.size}
                        </span>
                      ) : (
                        <span class="text-[10px] text-slate-300">-</span>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}
  </div>

    <!-- 资源详细介绍与说明（仅当填写了真实说明时才显示，无内容则彻底隐藏） -->
    {resource.description && resource.description.trim().length > 0 && resource.description !== resource.title && (
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-base sm:text-lg font-bold text-slate-900 flex items-center space-x-2">
            <span>📝 内容介绍与使用说明</span>
          </h2>
