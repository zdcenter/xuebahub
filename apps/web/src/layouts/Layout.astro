---
import '../styles/global.css';
import { getApiBaseUrl } from '../lib/api';
import QRCode from 'qrcode';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  hasHeroSearch?: boolean;
  image?: string;
}

const {
  title,
  description,
  keywords,
  canonicalUrl,
  hasHeroSearch: propHasHeroSearch,
  image
} = Astro.props;

// 构造绝对路径的 Open Graph 社交分享缩略图 (微信/QQ 爬虫严格要求带协议的绝对 PNG/JPG 地址)
let ogImageUrl = image || '';
if (ogImageUrl) {
  if (!ogImageUrl.startsWith('http://') && !ogImageUrl.startsWith('https://')) {
    ogImageUrl = new URL(ogImageUrl, Astro.url).href;
  }
} else {
  ogImageUrl = new URL('/og-cover.png', Astro.url).href;
}

const apiBase = getApiBaseUrl(Astro.url);

// 动态拉取在线业务频道 (严格仅展示已上线的频道)
let navChannels: { slug: string; name: string; icon: string }[] = [];
let isNavApiConnected = false;
try {
  const chRes = await fetch(`${apiBase}/api/v1/public/channels`, { signal: AbortSignal.timeout(6000) });
  if (chRes.ok) {
    const chData = await chRes.json();
    const rawList = Array.isArray(chData.data) ? chData.data : (chData.data?.items || []);
    navChannels = rawList.map((c: any) => ({
      slug: c.slug,
      name: c.name,
      icon: c.icon
    }));
    isNavApiConnected = true;
  }
} catch (e) {}

if (!isNavApiConnected && navChannels.length === 0) {
  navChannels = [
    { slug: 'edu', name: '刚需教辅学习', icon: '📚' }
  ];
}

// 核心教辅学段与 Hover 二级快捷直达菜单（方案一：高信息密度与极致检索下钻）
interface SubMenuItem {
  id?: string;
  title: string;
  desc?: string;
  href: string;
  badge?: string;
}

interface NavStageItem {
  id?: string;
  title: string;
  slug: string;
  href: string;
  icon: string;
  badgeText?: string;
  isHot?: boolean;
  isSpecialHighlight?: boolean;
  subItems?: SubMenuItem[];
}

// 动态从数据库拉取后台配置的层级导航菜单 (彻底解耦硬编码，后台自由增删改查、排序、显隐)
let eduNavStages: NavStageItem[] = [];
let isNavMenuApiConnected = false;

try {
  const menuRes = await fetch(`${apiBase}/api/v1/public/nav-menus`, { signal: AbortSignal.timeout(6000) });
  if (menuRes.ok) {
    const menuData = await menuRes.json();
    const rawMenus = Array.isArray(menuData.data) ? menuData.data : [];
    if (rawMenus.length > 0) {
      eduNavStages = rawMenus.map((m: any) => ({
        id: m.id,
        title: m.title,
        slug: m.link_url ? m.link_url.replace(/^\//, '').split('?')[0] : m.id,
        href: m.link_url,
        icon: m.icon || '📚',
        badgeText: m.badge_text || '',
        isHot: m.is_special_highlight || (m.badge_text === 'HOT' || m.badge_text === '爆款'),
        isSpecialHighlight: m.is_special_highlight,
        subItems: (m.children || []).map((c: any) => ({
          id: c.id,
          title: c.title,
          desc: c.description,
          href: c.link_url,
          badge: c.badge_text
        }))
      }));
      isNavMenuApiConnected = true;
    }
  }
} catch (e) {}

// 仅在后端 API 离线时提供兜底（清爽纯粹的一级核心专区）
// 核心教辅专区定义（专注教育、考证与公考升学）
if (!isNavMenuApiConnected && eduNavStages.length === 0) {
  eduNavStages = [
    {
      title: "小学专区",
      slug: "primary",
      href: "/primary",
      icon: "🎒"
    },
    {
      title: "初中专区",
      slug: "junior",
      href: "/junior",
      icon: "📘"
    },
    {
      title: "高中专区",
      slug: "senior",
      href: "/senior",
      icon: "🎓"
    },
    {
      title: "考证专区",
      slug: "cert",
      href: "/cert",
      icon: "📋"
    },
    {
      title: "公考升学",
      slug: "exam",
      href: "/exam",
      icon: "🏛️"
    }
  ];
}

// 当前激活状态判断
const currentUrl = Astro.url;
const currentPath = currentUrl.pathname;
const rawPathSlug = currentPath.replace(/^\/+|\/+$/g, '');
const STAGE_ROUTES = ['/primary', '/junior', '/senior', '/cert', '/exam'];
const isCleanStageRoute = ['primary', 'junior', 'senior', 'cert', 'exam'].includes(rawPathSlug);
const currentStage = isCleanStageRoute ? rawPathSlug : (currentUrl.searchParams.get('stage') || '');
const currentQ = currentUrl.searchParams.get('q') || '';

// 智能判定当前页面是否自带 Hero 大搜索框：
// 若显式传入则优先遵从；若未传，则首页 ('/')、学段专区 ('/primary', '/junior', '/senior', '/cert', '/exam') 与教辅频道 ('/edu') 自动判定为自带 Hero 搜索框
const hasHeroSearch = propHasHeroSearch !== undefined
  ? propHasHeroSearch
  : (currentPath === '/' || currentPath === '/edu' || STAGE_ROUTES.includes(currentPath) || navChannels.some(c => currentPath === `/${c.slug}`));

// 动态拉取系统全局配置 (站点标题、全站公告、QQ交流群、客服邮箱、版权备案)
interface SiteSettingsData {
  site_name: string;
  site_title: string;
  site_subtitle: string;
  keywords: string;
  qq_group: string;
  qq_group_url: string;
  contact_email: string;
  contact_wechat?: string;
  icp_beian?: string;
  gongan_beian?: string;
  copyright_text: string;
  disclaimer_text: string;
  announcement_active: boolean;
  announcement_text: string;
  announcement_url?: string;
  announcement_badge: string;
  announcement_type: string;
}

let siteSettings: SiteSettingsData = {
  site_name: "学霸网",
  site_title: "学霸网 - 中小学同步教辅、网盘学习资源与考试真题平台",
  site_subtitle: "中小学名校期末冲刺卷、人教版同步教辅、实用工具素材与精品网盘学习资料，支持A4高清打印与极速网盘转存。",
  keywords: "学霸网,xuebaw.com,网盘资源,中小学试卷下载,期末冲刺卷,人教版同步教辅,夸克网盘学习资料,百度网盘资源,考试真题",
  qq_group: "625248438",
  qq_group_url: "https://qm.qq.com/cgi-bin/qm/qr?k=&jump_from=webapi&authKey=&uin=625248438",
  contact_email: "support@xuebaw.com",
  copyright_text: "© 2026 学霸网 (xuebaw.com). All rights reserved.",
  disclaimer_text: "免责声明：本站所有资源均来自互联网公开平台与公开考试题型归纳整理，仅供个人学习研究交流使用，版权归原作者所有。",
  announcement_active: false,
  announcement_text: "",
  announcement_badge: "HOT",
  announcement_type: "blue"
};

try {
  const setRes = await fetch(`${apiBase}/api/v1/public/settings`, { signal: AbortSignal.timeout(6000) });
  if (setRes.ok) {
    const setJson = await setRes.json();
    if (setJson.data) {
      siteSettings = { ...siteSettings, ...setJson.data };
    }
  }
} catch (e) {}

const defaultTitle = "学霸网 - 中小学同步教辅、网盘学习资源与考试真题平台";
const defaultDesc = "学霸网 (xuebaw.com) 免费提供中小学名校期末冲刺卷、人教版同步教辅、实用工具素材与精品网盘学习资料，支持A4高清打印与极速网盘转存。";
const defaultKeywords = "学霸网,xuebaw.com,网盘资源,中小学试卷下载,期末冲刺卷,人教版同步教辅,夸克网盘学习资料,百度网盘资源,考试真题";

const pageTitle = title || siteSettings.site_title || defaultTitle;
const pageDesc = description || siteSettings.site_subtitle || defaultDesc;
const pageKeywords = keywords || siteSettings.keywords || defaultKeywords;

// 构造全站分享专属二维码 (SVG 格式，高对比度免外部图片依赖)
let siteQrSvg = '';
try {
  siteQrSvg = await QRCode.toString('https://xuebaw.com', {
    type: 'svg',
    margin: 1,
    width: 140,
    color: {
      dark: '#0f172a',
      light: '#ffffff'
    }
  });
} catch (e) {
  siteQrSvg = '';
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO TDK 深度优化 -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={pageKeywords} />
    <link rel="canonical" href={canonicalUrl || Astro.url.href} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    
    <!-- 微信/QQ/小红书/全社交平台 Open Graph 协议卡片与缩略图规范 -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteSettings.site_name || "学霸网"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl || Astro.url.href} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter / 现代社交媒体卡片标准 -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    
    <!-- 移动端防缩放与原生流畅渲染 -->
    <meta name="theme-color" content="#2563eb" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-blue-500 selection:text-white">
    <!-- 微信客户端首图自动探测抓取规范 (display:none 确保页面不可见但微信分享爬虫第一时间抓取封面) -->
    <div style="display:none;" aria-hidden="true">
      <img src={ogImageUrl} alt="学霸网资料分享缩略图" width="600" height="600" />
    </div>

    <!-- 全站动态吸顶公告横幅 (由后台全局系统设置动态管控) -->
    {siteSettings.announcement_active && siteSettings.announcement_text && (
      <div 
        id="top-announcement-banner"
        data-banner-text={siteSettings.announcement_text}
        class={`relative z-50 border-b text-xs sm:text-sm font-medium transition-all duration-300 ${
          siteSettings.announcement_type === 'amber'
            ? 'bg-amber-500/10 text-amber-800 border-amber-500/20'
            : siteSettings.announcement_type === 'emerald'
            ? 'bg-emerald-500/10 text-emerald-800 border-emerald-500/20'
            : siteSettings.announcement_type === 'rose'
            ? 'bg-rose-500/10 text-rose-800 border-rose-500/20'
            : 'bg-blue-600/10 text-blue-800 border-blue-600/20'
        }`}
      >
        <div class="max-w-7xl mx-auto px-4 py-2 sm:py-2.5 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 overflow-hidden flex-1 min-w-0">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold tracking-wider bg-current/10 shrink-0">
              {siteSettings.announcement_badge || 'HOT'}
            </span>
            {siteSettings.announcement_url ? (
              <a 
                href={siteSettings.announcement_url} 
                class="truncate hover:underline flex items-center gap-1 font-semibold"
              >
                <span>{siteSettings.announcement_text}</span>
                <span class="text-xs shrink-0">➔</span>
              </a>
            ) : (
              <span class="truncate">{siteSettings.announcement_text}</span>
            )}
          </div>
          <button
            type="button"
            id="close-announcement-btn"
            title="关闭公告通知"
            class="p-1 rounded-full hover:bg-current/10 cursor-pointer shrink-0 transition-colors opacity-75 hover:opacity-100"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <script is:inline>
        (function() {
          try {
            const banner = document.getElementById('top-announcement-banner');
            const closeBtn = document.getElementById('close-announcement-btn');
            if (!banner) return;
            const bannerText = banner.getAttribute('data-banner-text');
            const dismissed = localStorage.getItem('dismissed_announcement');
            if (dismissed && dismissed === bannerText) {
              banner.style.display = 'none';
            }
            if (closeBtn) {
              closeBtn.addEventListener('click', function() {
                banner.style.display = 'none';
                if (bannerText) {
                  localStorage.setItem('dismissed_announcement', bannerText);
                }
              });
            }
          } catch(e) {}
        })();
      </script>
    )}

    <!-- 顶部导航栏 -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-2 xl:gap-4">
          <!-- Logo 品牌区 (严格单行不换行，融入学霸网全新矢量徽标) -->
          <div class="flex items-center space-x-2.5 shrink-0">
            <a href="/" class="flex items-center space-x-2.5 text-blue-600 font-extrabold text-base sm:text-lg tracking-tight whitespace-nowrap group">
              <img
                src="/logo.svg"
                alt="学霸网 Logo"
                class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl shadow-md shadow-blue-500/25 shrink-0 object-contain group-hover:scale-105 group-hover:rotate-1 transition-all"
              />
              <div class="flex flex-col">
                <div class="flex items-center space-x-1.5 leading-none">
                  <span class="bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700 bg-clip-text text-transparent font-black tracking-tight text-lg sm:text-xl">学霸网</span>
                  <span class="text-[10px] px-1.5 py-0.5 bg-gradient-to-r from-amber-50 to-orange-50 text-amber-800 rounded-md font-extrabold border border-amber-200/90 flex items-center gap-0.5 shadow-2xs">
                    <span>👑</span><span>真题精选</span>
                  </span>
                </div>
                <span class="text-[9px] font-mono text-slate-400 font-bold tracking-wider pt-0.5">xuebaw.com</span>
              </div>
            </a>
          </div>

          <!-- PC 端核心学段直达专区 (5大垂直专区·极简纯粹) -->
          <nav class="hidden lg:flex items-center space-x-1 xl:space-x-1.5 font-medium text-slate-600 shrink-0">
            <a
              href="/"
              class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                currentPath === '/' && !currentStage && !currentQ
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
              }`}
            >
              <span>🌐</span>
              <span class="whitespace-nowrap">全部</span>
            </a>

            <!-- 核心学段专区：小学、初中、高中、考证、公考升学 -->
            {eduNavStages.map((item) => {
              const isActive = (currentPath === item.href) || (currentStage === item.slug) || (currentPath === `/${item.slug}`);
              const hasSubs = item.subItems && item.subItems.length > 0;
              return (
                <div class="relative group/nav">
                  <a
                    href={item.href}
                    class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                      isActive
                        ? 'bg-blue-600 text-white shadow-xs'
                        : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
                    }`}
                  >
                    <span>{item.icon}</span>
                    <span class="whitespace-nowrap">{item.title}</span>
                    {item.badgeText && (
                      <span class="px-1.5 py-0.2 text-[9px] font-extrabold uppercase rounded bg-red-500 text-white">
                        {item.badgeText}
                      </span>
                    )}
                    {hasSubs && (
                      <svg class="w-3 h-3 text-slate-400 group-hover/nav:text-blue-600 group-hover/nav:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    )}
                  </a>

                  {hasSubs && (
                    <div class="absolute left-0 top-full pt-1 hidden group-hover/nav:block z-50 min-w-[210px]">
                      <div class="bg-white rounded-xl shadow-xl border border-slate-100 p-1.5 text-xs divide-y divide-slate-50">
                        {item.subItems!.map((sub) => (
                          <a
                            href={sub.href}
                            class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-blue-50/80 hover:text-blue-600 text-slate-700 transition font-medium group/sub"
                          >
                            <span class="truncate">{sub.title}</span>
                            {sub.badge && (
                              <span class="ml-1.5 px-1.5 py-0.5 text-[9px] font-bold rounded bg-amber-100 text-amber-700 group-hover/sub:bg-blue-100 group-hover/sub:text-blue-700">
                                {sub.badge}
                              </span>
                            )}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              );
            })}

            <!-- 求资料 / 找卷愿望池入口 -->
            <button
              type="button"
              class="btn-open-request-modal whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 text-slate-700 hover:text-blue-600 hover:bg-blue-50/80 cursor-pointer"
              title="找不到想要的试卷资料？向平台和研友求助"
            >
              <span>📝</span>
              <span class="whitespace-nowrap">求资料</span>
            </button>
          </nav>

          <!-- 顶部右侧：备考清单、快捷检索框与移动端菜单按钮 -->
          <div class="flex items-center space-x-2 shrink-0">
            <!-- 备考清单快捷打开入口 -->
            <button
              type="button"
              id="header-open-bookmarks"
              class="whitespace-nowrap shrink-0 px-2.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1 text-slate-700 hover:text-amber-600 hover:bg-amber-50 cursor-pointer border border-slate-200/80 hover:border-amber-200 shadow-2xs"
              title="查看我的备考清单 / 本地收藏夹"
            >
              <span class="text-amber-500 text-sm leading-none">⭐️</span>
              <span class="hidden sm:inline">清单</span>
              <span class="bookmark-count-badge px-1.5 py-0.2 bg-amber-500 text-white text-[10px] font-black rounded-full hidden">0</span>
            </button>

            {!hasHeroSearch && (
              <>
                <!-- 详情页桌面端快速检索框 -->
                <form action="/edu" method="GET" class="hidden md:flex items-center relative shrink-0">
                  <input
                    type="text"
                    name="q"
                    placeholder="搜全站真题、微课、教资..."
                    class="w-36 lg:w-48 xl:w-56 pl-7 pr-2.5 py-1.5 text-xs bg-slate-100/80 hover:bg-slate-200/60 focus:bg-white text-slate-800 placeholder-slate-400 rounded-xl border border-slate-200/70 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none"
                  />
                  <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </form>

                <!-- 详情页移动端快速查找图标 -->
                <a href="/#search-box" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl md:hidden" title="快速查找资料">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </a>
              </>
            )}

            <!-- 移动端全景二级分类抽屉触发按钮 -->
            <button
              id="open-mobile-drawer"
              type="button"
              class="lg:hidden p-2 text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-xl flex items-center space-x-1 text-xs font-bold border border-slate-200/90 whitespace-nowrap"
              title="打开全部分类菜单"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
              </svg>
              <span>分类导航</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 移动端学段横向平滑滚动条 -->
