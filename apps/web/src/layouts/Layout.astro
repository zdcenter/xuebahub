          <div class="grid grid-cols-2 gap-2">
            <a href="/edu?stage=primary&q=小升初" class="p-2 bg-red-50 hover:bg-red-100 border border-red-200 rounded-xl text-xs font-bold text-red-700 flex items-center space-x-1">
              <span>🎯</span><span>小升初择校考</span>
            </a>
            <a href="/edu?q=期末冲刺" class="p-2 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-xl text-xs font-bold text-amber-700 flex items-center space-x-1">
              <span>⚡</span><span>期末押题密卷</span>
            </a>
          </div>
        </div>

        {eduNavStages.filter(s => s.subItems).map((stage) => (
          <div class="border border-slate-200/80 rounded-2xl p-3 bg-slate-50/50 space-y-2">
            <div class="flex items-center justify-between pb-1 border-b border-slate-200/60">
              <a href={stage.href} class="font-bold text-xs sm:text-sm text-slate-800 flex items-center space-x-1 hover:text-blue-600">
                <span>{stage.icon}</span>
                <span>{stage.title}</span>
              </a>
              <a href={stage.href} class="text-[11px] text-blue-600 font-medium">查看专区 ➔</a>
            </div>
            <div class="space-y-1">
              {stage.subItems?.map((sub) => (
                <a
                  href={sub.href}
                  class="flex items-center justify-between p-2 rounded-xl bg-white hover:bg-blue-50 border border-slate-100 transition"
                >
                  <div>
                    <div class="text-xs font-bold text-slate-800 flex items-center space-x-1">
                      <span>{sub.title}</span>
                      {sub.badge && (
                        <span class="px-1.5 py-0.2 text-[9px] font-extrabold rounded bg-blue-100 text-blue-700">
                          {sub.badge}
                        </span>
                      )}
                    </div>
                    {sub.desc && (
                      <div class="text-[10px] text-slate-400 mt-0.5">{sub.desc}</div>
                    )}
                  </div>
                  <span class="text-slate-300 text-xs">➔</span>
                </a>
              ))}
            </div>
          </div>
        ))}

        {otherActiveChannels.length > 0 && (
          <div class="border border-slate-200/80 rounded-2xl p-3 bg-slate-50/50 space-y-2">
            <div class="text-[11px] font-bold text-slate-500">其他业务专区</div>
            <div class="space-y-1">
              {otherActiveChannels.map((c) => {
                const cleanName = c.name.replace(/^[\s\p{Emoji}\uFE0F]+/u, '').trim();
                return (
                  <a href={`/${c.slug}`} class="flex items-center space-x-2 p-2 rounded-xl bg-white text-xs font-bold text-slate-800 hover:text-blue-600">
                    <span>{c.icon}</span>
                    <span>{cleanName}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- 主体区域 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 页脚与合规免责声明（合规关键） -->
    <footer class="bg-white border-t border-slate-200 mt-16 py-12 text-sm text-slate-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-3 md:col-span-2">
            <div class="font-bold text-slate-800 text-base flex items-center space-x-2">
              <span>学霸网 (xuebaw.com) - 专业的网盘学习资源站</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              聚焦中小学同步名校密卷、期末押题卷、奥数思维拓展及成人考证真题。所有资料均经过排版清洗，支持 A4 纸张直接打印练习，帮助家长和考生高效备考。
            </p>
          </div>
          <div>
            <div class="font-semibold text-slate-700 mb-2">快速导航</div>
            <ul class="space-y-1.5 text-xs">
              <li><a href="/?stage=primary" class="hover:text-blue-600">小学 1-6 年级期末卷</a></li>
              <li><a href="/?stage=junior" class="hover:text-blue-600">中考历年真题分类汇编</a></li>
              <li><a href="/?stage=cert" class="hover:text-blue-600">教师资格证统考笔试清单</a></li>
              <li><a href="/?stage=exam" class="hover:text-blue-600">国家公务员申论行测冲刺</a></li>
            </ul>
          </div>
          <div>
            <div class="font-semibold text-slate-700 mb-2">版权保护与合规通道</div>
            <p class="text-xs text-slate-500 leading-relaxed">
              侵权投诉/下架建议：<br />
              <span class="font-mono text-slate-700">support@xuebaw.com</span><br />
              收到邮件后我们将在 24 小时内彻底核实并下架链接。
            </p>
          </div>
        </div>

        <div class="border-t border-slate-100 pt-6 text-xs text-slate-400 text-center space-y-1">
          <p>免责声明：本站所有资源均来自互联网公开平台与公开考试题型归纳整理，仅供个人学习研究交流使用，版权归原作者所有。</p>
          <p>© 2026 学霸网 (xuebaw.com). All rights reserved.</p>
        </div>
      </div>
    </footer>

    <!-- 移动端全景分类抽屉交互逻辑 -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const openBtn = document.getElementById('open-mobile-drawer');
        const openSubBtn = document.getElementById('open-mobile-drawer-sub');
        const closeBtn = document.getElementById('close-mobile-drawer');
        const drawer = document.getElementById('mobile-drawer');
        const backdrop = document.getElementById('mobile-drawer-backdrop');

        function openDrawer() {
          drawer?.classList.remove('translate-x-full');
          backdrop?.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          drawer?.classList.add('translate-x-full');
          backdrop?.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        }

        openBtn?.addEventListener('click', openDrawer);
        openSubBtn?.addEventListener('click', openDrawer);
        closeBtn?.addEventListener('click', closeDrawer);
        backdrop?.addEventListener('click', closeDrawer);

        // 点击抽屉内任意链接后自动平滑收起抽屉
        drawer?.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeDrawer);
        });
      });
    </script>
  </body>
</html>
