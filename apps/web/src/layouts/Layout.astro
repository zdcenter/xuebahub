---
import '../styles/global.css';
import { getApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
}

const {
  title = "学霸网 - 中小学同步教辅、网盘学习资源与考试真题平台",
  description = "学霸网 (xuebaw.com) 免费提供中小学名校期末冲刺卷、人教版同步教辅、实用工具素材与精品网盘学习资料，支持A4高清打印与极速网盘转存。",
  keywords = "学霸网,xuebaw.com,网盘资源,中小学试卷下载,期末冲刺卷,人教版同步教辅,夸克网盘学习资料,百度网盘资源,考试真题",
  canonicalUrl
} = Astro.props;

const apiBase = getApiBaseUrl();

// 动态拉取在线业务频道 (严格仅展示已上线的频道)
let navChannels: { slug: string; name: string; icon: string }[] = [];
let isNavApiConnected = false;
try {
  const chRes = await fetch(`${apiBase}/api/v1/public/channels`, { signal: AbortSignal.timeout(6000) });
  if (chRes.ok) {
    const chData = await chRes.json();
    const rawList = Array.isArray(chData.data) ? chData.data : (chData.data?.items || []);
    navChannels = rawList.map((c: any) => ({
      slug: c.slug,
      name: c.name,
      icon: c.icon
    }));
    isNavApiConnected = true;
  }
} catch (e) {}

if (!isNavApiConnected && navChannels.length === 0) {
  navChannels = [
    { slug: 'edu', name: '刚需教辅学习', icon: '📚' }
  ];
}

// 核心教辅学段与 Hover 二级快捷直达菜单（方案一：高信息密度与极致检索下钻）
interface SubMenuItem {
  id?: string;
  title: string;
  desc?: string;
  href: string;
  badge?: string;
}

interface NavStageItem {
  id?: string;
  title: string;
  slug: string;
  href: string;
  icon: string;
  badgeText?: string;
  isHot?: boolean;
  isSpecialHighlight?: boolean;
  subItems?: SubMenuItem[];
}

// 动态从数据库拉取后台配置的层级导航菜单 (彻底解耦硬编码，后台自由增删改查、排序、显隐)
let eduNavStages: NavStageItem[] = [];
let isNavMenuApiConnected = false;

try {
  const menuRes = await fetch(`${apiBase}/api/v1/public/nav-menus`, { signal: AbortSignal.timeout(6000) });
  if (menuRes.ok) {
    const menuData = await menuRes.json();
    const rawMenus = Array.isArray(menuData.data) ? menuData.data : [];
    if (rawMenus.length > 0) {
      eduNavStages = rawMenus.map((m: any) => ({
        id: m.id,
        title: m.title,
        slug: m.id,
        href: m.link_url,
        icon: m.icon || '📚',
        badgeText: m.badge_text || '',
        isHot: m.is_special_highlight || (m.badge_text === 'HOT' || m.badge_text === '爆款'),
        isSpecialHighlight: m.is_special_highlight,
        subItems: (m.children || []).map((c: any) => ({
          id: c.id,
          title: c.title,
          desc: c.description,
          href: c.link_url,
          badge: c.badge_text
        }))
      }));
      isNavMenuApiConnected = true;
    }
  }
} catch (e) {}

// 仅在后端 API 离线时提供兜底
if (!isNavMenuApiConnected && eduNavStages.length === 0) {
  eduNavStages = [
    {
      title: "小学专区",
      slug: "primary",
      href: "/edu?stage=primary",
      icon: "🎒",
      subItems: [
        { title: "小升初择校与名校分班卷", desc: "重点初中选拔密卷/历年真题分类", href: "/edu?stage=primary&q=小升初", badge: "爆款" },
        { title: "小学奥数思维拓展30讲", desc: "和差倍/鸡兔同笼/拔尖压轴全题型", href: "/edu?stage=primary&q=奥数", badge: "培优" },
        { title: "4-6年级名校期末冲刺卷", desc: "重点小学期末夺冠密卷PDF", href: "/edu?stage=primary&q=期末冲刺", badge: "精选" },
        { title: "1-3年级基础同步期末", desc: "基础字词/口算速算/人教版单元卷", href: "/edu?stage=primary&grade=三年级" },
        { title: "人教版语数英同步教辅", desc: "A4标准排版无水印直接打印", href: "/edu?stage=primary&q=人教版" },
      ]
    },
    {
      title: "小升初择校",
      slug: "xiaoshengchu",
      href: "/edu?stage=primary&q=小升初",
      icon: "🎯",
      isHot: true
    },
    {
      title: "初中专区",
      slug: "junior",
      href: "/edu?stage=junior",
      icon: "📘",
      subItems: [
        { title: "中考历年真题分类汇编", desc: "中考全国各省真题必刷", href: "/edu?stage=junior&q=中考真题", badge: "必刷" },
        { title: "初中数学几何压轴题", desc: "配名师高清手写解答步骤", href: "/edu?stage=junior&q=压轴题" },
        { title: "初一初二期末冲刺卷", desc: "人教版/北师大版同步压轴", href: "/edu?stage=junior&q=冲刺" },
      ]
    },
    {
      title: "高中专区",
      slug: "senior",
      href: "/edu?stage=senior",
      icon: "🎓",
      subItems: [
        { title: "新高考一模二模真题", desc: "名校名师精选联合冲刺卷", href: "/edu?stage=senior&q=高考一模", badge: "2026" },
        { title: "导数极值与圆锥曲线", desc: "含名师手撕解题高清精讲视频", href: "/edu?stage=senior&q=数学压轴", badge: "名师" },
        { title: "高中学霸手撕复习笔记", desc: "高频考点思维导图PDF", href: "/edu?stage=senior&q=笔记" },
      ]
    },
    {
      title: "成人考证",
      slug: "cert",
      href: "/edu?stage=cert",
      icon: "📋",
      subItems: [
        { title: "教师资格证（统考笔试）", desc: "中学/小学综合素质核心背诵清单", href: "/edu?stage=cert&q=教师资格证", badge: "刚需" },
        { title: "公务员国考/省考冲刺", desc: "申论行测秒杀题型归纳", href: "/edu?stage=exam&q=考公" },
        { title: "考研公共课核心笔记", desc: "政治/英语核心考点精编", href: "/edu?stage=exam&q=考研" },
      ]
    },
    {
      title: "期末压轴专题",
      slug: "topic",
      href: "/edu?q=期末冲刺",
      icon: "⚡",
      isHot: true
    }
  ];
}

// 未来扩展频道（如 tools, games 上线时动态并入导航右侧）
const otherActiveChannels = navChannels.filter(c => c.slug !== 'edu');

// 当前激活状态判断
const currentUrl = Astro.url;
const currentPath = currentUrl.pathname;
const currentStage = currentUrl.searchParams.get('stage') || '';
const currentQ = currentUrl.searchParams.get('q') || '';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO TDK 深度优化 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl || Astro.url.href} />
    
    <!-- 移动端防缩放与原生流畅渲染 -->
    <meta name="theme-color" content="#2563eb" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-blue-500 selection:text-white">
    <!-- 顶部导航栏 -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-2 xl:gap-4">
          <!-- Logo 品牌区 (严格单行不换行) -->
          <div class="flex items-center space-x-2.5 shrink-0">
            <a href="/" class="flex items-center space-x-2 text-blue-600 font-extrabold text-base sm:text-lg tracking-tight whitespace-nowrap">
              <span class="p-1.5 sm:p-2 bg-blue-600 text-white rounded-xl shadow-md shadow-blue-500/20 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </span>
              <span class="whitespace-nowrap">学霸网<span class="text-[11px] ml-1 px-1.5 py-0.5 bg-blue-50 text-blue-700 rounded-md font-medium border border-blue-200">教辅精选</span></span>
            </a>
          </div>

          <!-- PC 端核心学段与 Hover 二级轻量下拉菜单 (lg及以上展示，加 whitespace-nowrap 绝不折行) -->
          <nav class="hidden lg:flex items-center space-x-0.5 xl:space-x-1 font-medium text-slate-600 shrink-0">
            <a
              href="/"
              class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                currentPath === '/' && !currentStage && !currentQ
                  ? 'bg-blue-50 text-blue-600'
                  : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
              }`}
            >
              <span>🌐</span>
              <span class="whitespace-nowrap">全部</span>
            </a>

            {eduNavStages.map((item) => (
              item.isHot ? (
                <a
                  href={item.href}
                  class={`whitespace-nowrap shrink-0 ml-0.5 px-2.5 xl:px-3 py-1.5 rounded-xl font-bold text-xs flex items-center space-x-1 shadow-xs transition hover:shadow-sm border ${
                    item.slug === 'xiaoshengchu'
                      ? 'bg-gradient-to-r from-red-500/10 to-amber-500/10 text-red-700 border-red-200/80 hover:border-red-300'
                      : 'bg-gradient-to-r from-amber-500/10 via-rose-500/10 to-amber-500/10 text-amber-700 border-amber-300/70 hover:border-amber-400'
                  }`}
                >
                  <span class="animate-pulse">{item.icon}</span>
                  <span class="whitespace-nowrap">{item.title}</span>
                  <span class={`px-1 py-0.2 text-[9px] font-extrabold uppercase rounded text-white ${item.slug === 'xiaoshengchu' ? 'bg-red-500' : 'bg-amber-500'}`}>HOT</span>
                </a>
              ) : (
                <div class="relative group shrink-0">
                  <a
                    href={item.href}
                    class={`whitespace-nowrap shrink-0 px-2 xl:px-2.5 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                      currentStage === item.slug
                        ? 'bg-blue-50 text-blue-600'
                        : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
                    }`}
                  >
                    <span>{item.icon}</span>
                    <span class="whitespace-nowrap">{item.title}</span>
                    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>

                  <!-- 二级轻量下拉菜单浮窗 (增加 pt-2 绝不掉落) -->
                  {item.subItems && (
                    <div class="absolute left-0 top-full pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 transform group-hover:translate-y-0 translate-y-1">
                      <div class="bg-white/95 backdrop-blur-md rounded-2xl shadow-xl shadow-slate-900/10 border border-slate-200/90 p-2 space-y-0.5">
                        <div class="px-2.5 py-1 text-[11px] font-bold text-slate-400 border-b border-slate-100 flex items-center justify-between">
                          <span>{item.title}重点分类</span>
                          <span class="text-[10px] text-blue-500">A4高清打印</span>
                        </div>
                        {item.subItems.map((sub) => (
                          <a
                            href={sub.href}
                            class="flex items-start justify-between p-2 rounded-xl hover:bg-blue-50/80 group/sub transition text-left"
                          >
                            <div>
                              <div class="text-xs font-bold text-slate-800 group-hover/sub:text-blue-600 flex items-center gap-1.5 whitespace-nowrap">
                                <span>{sub.title}</span>
                                {sub.badge && (
                                  <span class="px-1.5 py-0.2 text-[9px] font-extrabold rounded bg-blue-100 text-blue-700">
                                    {sub.badge}
                                  </span>
                                )}
                              </div>
                              {sub.desc && (
                                <p class="text-[11px] text-slate-400 group-hover/sub:text-slate-600 mt-0.5 whitespace-nowrap">
                                  {sub.desc}
                                </p>
                              )}
                            </div>
                            <svg class="w-3.5 h-3.5 text-slate-300 group-hover/sub:text-blue-600 group-hover/sub:translate-x-0.5 transition-all mt-1 shrink-0 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )
            ))}

            <!-- 动态兼顾未来其他在线频道 (如 tools, games) -->
            {otherActiveChannels.map((c) => {
              const cleanName = c.name.replace(/^[\s\p{Emoji}\uFE0F]+/u, '').trim();
              return (
                <a
                  href={`/${c.slug}`}
                  class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                    currentPath === `/${c.slug}`
                      ? 'bg-blue-50 text-blue-600'
                      : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
                  }`}
                >
                  <span>{c.icon}</span>
                  <span class="whitespace-nowrap">{cleanName}</span>
                </a>
              );
            })}
          </nav>

          <!-- 顶部右侧：快捷检索框与移动端菜单按钮 -->
          <div class="flex items-center space-x-2 shrink-0">
            <!-- 桌面端宽屏搜索输入框 -->
            <form action="/edu" method="GET" class="hidden xl:flex items-center relative shrink-0">
              <input
                type="text"
                name="q"
                placeholder="搜索小升初、真题、教资..."
                class="w-40 2xl:w-52 pl-7 pr-2.5 py-1.5 text-xs bg-slate-100/80 hover:bg-slate-200/60 focus:bg-white text-slate-800 placeholder-slate-400 rounded-xl border border-slate-200/70 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none"
              />
              <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </form>

            <!-- 超宽屏品质徽标 -->
            <div class="hidden 2xl:flex items-center text-xs text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-full font-medium shrink-0 whitespace-nowrap">
              <span class="inline-block w-2 h-2 rounded-full bg-amber-500 mr-1.5 animate-pulse"></span>
              全站试卷配手写解析
            </div>

            <!-- 中等屏幕快速搜索图标 -->
            <a href="/#search-box" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl xl:hidden" title="快速查找资料">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </a>

            <!-- 移动端全景二级分类抽屉触发按钮 -->
            <button
              id="open-mobile-drawer"
              type="button"
              class="lg:hidden p-2 text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-xl flex items-center space-x-1 text-xs font-bold border border-slate-200/90 whitespace-nowrap"
              title="打开全部分类菜单"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
              </svg>
              <span>分类导航</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 移动端学段横向平滑滚动条 -->
      <div class="lg:hidden bg-white/95 border-t border-slate-100 px-3 py-2 flex items-center space-x-1.5 overflow-x-auto no-scrollbar">
        <span class="text-[11px] font-bold text-slate-400 whitespace-nowrap">直达:</span>
        <a href="/" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentPath === '/' && !currentStage && !currentQ ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>全部</a>
        <a href="/edu?stage=primary&q=小升初" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-red-50 text-red-700 border border-red-200 flex items-center space-x-0.5">
          <span>🎯</span><span>小升初</span>
        </a>
        <a href="/edu?stage=primary" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'primary' && currentQ !== '小升初' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🎒 小学</a>
        <a href="/edu?stage=junior" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'junior' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>📘 初中</a>
        <a href="/edu?stage=senior" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'senior' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🎓 高中</a>
        <a href="/edu?stage=cert" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'cert' || currentStage === 'exam' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>📋 考证</a>
        <a href="/edu?q=期末冲刺" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">⚡ 期末</a>
        <button id="open-mobile-drawer-sub" type="button" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-600 border border-blue-200 flex items-center space-x-1">
          <span>📑</span><span>全部分类 ▾</span>
        </button>
      </div>
    </header>

    <!-- 移动端全景二级分类手风琴/抽屉 (解决移动端二级弹起问题) -->
    <div id="mobile-drawer-backdrop" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <div id="mobile-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-xs sm:max-w-sm bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
      <!-- 抽屉顶部 -->
      <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div class="flex items-center space-x-2">
          <span class="p-1.5 bg-blue-600 text-white rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </span>
          <div>
            <div class="font-extrabold text-slate-800 text-sm">全站分类与真题导航</div>
            <div class="text-[10px] text-slate-400">点击任意分类直达考点资料</div>
          </div>
        </div>
        <button id="close-mobile-drawer" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg" title="关闭菜单">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- 抽屉搜索框 -->
      <div class="p-3 border-b border-slate-100 bg-white">
