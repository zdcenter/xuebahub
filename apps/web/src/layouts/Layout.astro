---
import '../styles/global.css';
import { getApiBaseUrl } from '../lib/api';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  hasHeroSearch?: boolean;
}

const {
  title = "学霸网 - 中小学同步教辅、网盘学习资源与考试真题平台",
  description = "学霸网 (xuebaw.com) 免费提供中小学名校期末冲刺卷、人教版同步教辅、实用工具素材与精品网盘学习资料，支持A4高清打印与极速网盘转存。",
  keywords = "学霸网,xuebaw.com,网盘资源,中小学试卷下载,期末冲刺卷,人教版同步教辅,夸克网盘学习资料,百度网盘资源,考试真题",
  canonicalUrl,
  hasHeroSearch: propHasHeroSearch
} = Astro.props;

const apiBase = getApiBaseUrl(Astro.url);

// 动态拉取在线业务频道 (严格仅展示已上线的频道)
let navChannels: { slug: string; name: string; icon: string }[] = [];
let isNavApiConnected = false;
try {
  const chRes = await fetch(`${apiBase}/api/v1/public/channels`, { signal: AbortSignal.timeout(6000) });
  if (chRes.ok) {
    const chData = await chRes.json();
    const rawList = Array.isArray(chData.data) ? chData.data : (chData.data?.items || []);
    navChannels = rawList.map((c: any) => ({
      slug: c.slug,
      name: c.name,
      icon: c.icon
    }));
    isNavApiConnected = true;
  }
} catch (e) {}

if (!isNavApiConnected && navChannels.length === 0) {
  navChannels = [
    { slug: 'edu', name: '刚需教辅学习', icon: '📚' }
  ];
}

// 核心教辅学段与 Hover 二级快捷直达菜单（方案一：高信息密度与极致检索下钻）
interface SubMenuItem {
  id?: string;
  title: string;
  desc?: string;
  href: string;
  badge?: string;
}

interface NavStageItem {
  id?: string;
  title: string;
  slug: string;
  href: string;
  icon: string;
  badgeText?: string;
  isHot?: boolean;
  isSpecialHighlight?: boolean;
  subItems?: SubMenuItem[];
}

// 动态从数据库拉取后台配置的层级导航菜单 (彻底解耦硬编码，后台自由增删改查、排序、显隐)
let eduNavStages: NavStageItem[] = [];
let isNavMenuApiConnected = false;

try {
  const menuRes = await fetch(`${apiBase}/api/v1/public/nav-menus`, { signal: AbortSignal.timeout(6000) });
  if (menuRes.ok) {
    const menuData = await menuRes.json();
    const rawMenus = Array.isArray(menuData.data) ? menuData.data : [];
    if (rawMenus.length > 0) {
      eduNavStages = rawMenus.map((m: any) => ({
        id: m.id,
        title: m.title,
        slug: m.id,
        href: m.link_url,
        icon: m.icon || '📚',
        badgeText: m.badge_text || '',
        isHot: m.is_special_highlight || (m.badge_text === 'HOT' || m.badge_text === '爆款'),
        isSpecialHighlight: m.is_special_highlight,
        subItems: (m.children || []).map((c: any) => ({
          id: c.id,
          title: c.title,
          desc: c.description,
          href: c.link_url,
          badge: c.badge_text
        }))
      }));
      isNavMenuApiConnected = true;
    }
  }
} catch (e) {}

// 仅在后端 API 离线时提供兜底（清爽纯粹的一级核心专区）
// 核心教辅专区定义（专注教育、考证与公考升学）
if (!isNavMenuApiConnected && eduNavStages.length === 0) {
  eduNavStages = [
    {
      title: "小学专区",
      slug: "primary",
      href: "/primary",
      icon: "🎒"
    },
    {
      title: "初中专区",
      slug: "junior",
      href: "/junior",
      icon: "📘"
    },
    {
      title: "高中专区",
      slug: "senior",
      href: "/senior",
      icon: "🎓"
    },
    {
      title: "考证专区",
      slug: "cert",
      href: "/cert",
      icon: "📋"
    },
    {
      title: "公考升学",
      slug: "exam",
      href: "/exam",
      icon: "🏛️"
    }
  ];
}

// 当前激活状态判断
const currentUrl = Astro.url;
const currentPath = currentUrl.pathname;
const rawPathSlug = currentPath.replace(/^\/+|\/+$/g, '');
const STAGE_ROUTES = ['/primary', '/junior', '/senior', '/cert', '/exam'];
const isCleanStageRoute = ['primary', 'junior', 'senior', 'cert', 'exam'].includes(rawPathSlug);
const currentStage = isCleanStageRoute ? rawPathSlug : (currentUrl.searchParams.get('stage') || '');
const currentQ = currentUrl.searchParams.get('q') || '';

// 智能判定当前页面是否自带 Hero 大搜索框：
// 若显式传入则优先遵从；若未传，则首页 ('/')、学段专区 ('/primary', '/junior', '/senior', '/cert', '/exam') 与各频道目录 ('/edu', '/tools', '/games') 自动判定为自带 Hero 搜索框
const hasHeroSearch = propHasHeroSearch !== undefined
  ? propHasHeroSearch
  : (currentPath === '/' || currentPath === '/edu' || STAGE_ROUTES.includes(currentPath) || navChannels.some(c => currentPath === `/${c.slug}`));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO TDK 深度优化 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl || Astro.url.href} />
    
    <!-- 移动端防缩放与原生流畅渲染 -->
    <meta name="theme-color" content="#2563eb" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 antialiased selection:bg-blue-500 selection:text-white">
    <!-- 顶部导航栏 -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-2 xl:gap-4">
          <!-- Logo 品牌区 (严格单行不换行，融入学霸网全新矢量徽标) -->
          <div class="flex items-center space-x-2.5 shrink-0">
            <a href="/" class="flex items-center space-x-2.5 text-blue-600 font-extrabold text-base sm:text-lg tracking-tight whitespace-nowrap group">
              <img
                src="/logo.svg"
                alt="学霸网 Logo"
                class="w-9 h-9 sm:w-10 sm:h-10 rounded-2xl shadow-md shadow-blue-500/25 shrink-0 object-contain group-hover:scale-105 group-hover:rotate-1 transition-all"
              />
              <div class="flex flex-col">
                <div class="flex items-center space-x-1.5 leading-none">
                  <span class="bg-gradient-to-r from-blue-700 via-blue-600 to-indigo-700 bg-clip-text text-transparent font-black tracking-tight text-lg sm:text-xl">学霸网</span>
                  <span class="text-[10px] px-1.5 py-0.5 bg-gradient-to-r from-amber-50 to-orange-50 text-amber-800 rounded-md font-extrabold border border-amber-200/90 flex items-center gap-0.5 shadow-2xs">
                    <span>👑</span><span>真题精选</span>
                  </span>
                </div>
                <span class="text-[9px] font-mono text-slate-400 font-bold tracking-wider pt-0.5">xuebaw.com</span>
              </div>
            </a>
          </div>

          <!-- PC 端核心学段直达专区 (5大垂直专区·极简纯粹) -->
          <nav class="hidden lg:flex items-center space-x-1 xl:space-x-1.5 font-medium text-slate-600 shrink-0">
            <a
              href="/"
              class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1 ${
                currentPath === '/' && !currentStage && !currentQ
                  ? 'bg-blue-600 text-white shadow-xs'
                  : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
              }`}
            >
              <span>🌐</span>
              <span class="whitespace-nowrap">全部</span>
            </a>

            <!-- 核心学段专区：小学、初中、高中、考证、公考升学 -->
            {eduNavStages.map((item) => {
              const isActive = (currentPath === item.href) || (currentStage === item.slug) || (currentPath === `/${item.slug}`);
              return (
                <a
                  href={item.href}
                  class={`whitespace-nowrap shrink-0 px-2.5 xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-bold transition flex items-center space-x-1.5 ${
                    isActive
                      ? 'bg-blue-600 text-white shadow-xs'
                      : 'hover:text-blue-600 hover:bg-slate-100 text-slate-700'
                  }`}
                >
                  <span>{item.icon}</span>
                  <span class="whitespace-nowrap">{item.title}</span>
                  {item.badgeText && (
                    <span class="px-1.5 py-0.2 text-[9px] font-extrabold uppercase rounded bg-red-500 text-white">
                      {item.badgeText}
                    </span>
                  )}
                </a>
              );
            })}
          </nav>

          <!-- 顶部右侧：快捷检索框（仅在详情页等无 Hero 大搜索框的页面展示）与移动端菜单按钮 -->
          <div class="flex items-center space-x-2 shrink-0">
            {!hasHeroSearch && (
              <>
                <!-- 详情页桌面端快速检索框 -->
                <form action="/edu" method="GET" class="hidden md:flex items-center relative shrink-0">
                  <input
                    type="text"
                    name="q"
                    placeholder="搜全站真题、微课、教资..."
                    class="w-36 lg:w-48 xl:w-56 pl-7 pr-2.5 py-1.5 text-xs bg-slate-100/80 hover:bg-slate-200/60 focus:bg-white text-slate-800 placeholder-slate-400 rounded-xl border border-slate-200/70 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 transition-all outline-none"
                  />
                  <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </form>

                <!-- 详情页移动端快速查找图标 -->
                <a href="/#search-box" class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-xl md:hidden" title="快速查找资料">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                </a>
              </>
            )}

            <!-- 移动端全景二级分类抽屉触发按钮 -->
            <button
              id="open-mobile-drawer"
              type="button"
              class="lg:hidden p-2 text-slate-700 hover:text-blue-600 hover:bg-slate-100 rounded-xl flex items-center space-x-1 text-xs font-bold border border-slate-200/90 whitespace-nowrap"
              title="打开全部分类菜单"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
              </svg>
              <span>分类导航</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 移动端学段横向平滑滚动条 -->
      <div class="lg:hidden bg-white/95 border-t border-slate-100 px-3 py-2 flex items-center space-x-1.5 overflow-x-auto no-scrollbar">
        <span class="text-[11px] font-bold text-slate-400 whitespace-nowrap">直达:</span>
        <a href="/" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentPath === '/' && !currentStage && !currentQ ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>全部</a>
        <a href="/primary?q=小升初" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-red-50 text-red-700 border border-red-200 flex items-center space-x-0.5">
          <span>🎯</span><span>小升初</span>
        </a>
        <a href="/primary" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'primary' && currentQ !== '小升初' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🎒 小学</a>
        <a href="/junior" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'junior' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>📘 初中</a>
        <a href="/senior" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'senior' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🎓 高中</a>
        <a href="/cert" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'cert' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>📋 考证</a>
        <a href="/exam" class={`whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold transition ${currentStage === 'exam' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}`}>🏛️ 公考</a>
        <a href="/primary?q=期末冲刺" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">⚡ 期末</a>
        <button id="open-mobile-drawer-sub" type="button" class="whitespace-nowrap px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-600 border border-blue-200 flex items-center space-x-1">
          <span>📑</span><span>全部分类 ▾</span>
        </button>
      </div>
    </header>

    <!-- 移动端全景二级分类手风琴/抽屉 (解决移动端二级弹起问题) -->
    <div id="mobile-drawer-backdrop" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"></div>
    <div id="mobile-drawer" class="fixed inset-y-0 right-0 z-50 w-full max-w-xs sm:max-w-sm bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
      <!-- 抽屉顶部 -->
      <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
        <div class="flex items-center space-x-2">
          <span class="p-1.5 bg-blue-600 text-white rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </span>
          <div>
            <div class="font-extrabold text-slate-800 text-sm">全站分类与真题导航</div>
            <div class="text-[10px] text-slate-400">点击任意分类直达考点资料</div>
          </div>
        </div>
        <button id="close-mobile-drawer" class="p-1.5 text-slate-400 hover:text-slate-700 rounded-lg" title="关闭菜单">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- 抽屉搜索框 -->
      <div class="p-3 border-b border-slate-100 bg-white">
        <form action="/edu" method="GET" class="relative">
          <input
            type="text"
            name="q"
            placeholder="搜索小升初、中高考、教资..."
            class="w-full pl-8 pr-3 py-2 text-xs bg-slate-100 rounded-xl outline-none focus:bg-white focus:ring-2 focus:ring-blue-100 border border-transparent focus:border-blue-400"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>
      </div>

      <!-- 抽屉核心专区大按钮直达 -->
      <div class="flex-1 overflow-y-auto p-4 space-y-4">
        <div>
          <div class="text-[11px] font-bold text-slate-400 mb-2 flex items-center gap-1">
            <span>🏷️</span><span>核心专区</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <a
              href="/"
              class="p-3 bg-white hover:bg-blue-50 border border-slate-200/90 rounded-2xl flex flex-col justify-between shadow-2xs transition"
            >
              <div class="flex items-center space-x-2">
                <span class="text-xl">🌐</span>
                <span class="font-bold text-xs text-slate-900">全部资源</span>
              </div>
              <span class="text-[10px] text-blue-600 font-medium mt-1">浏览全站 ➔</span>
            </a>
            {eduNavStages.map((stage) => (
              <a
                href={stage.href}
                class="p-3 bg-white hover:bg-blue-50 border border-slate-200/90 rounded-2xl flex flex-col justify-between shadow-2xs transition"
              >
                <div class="flex items-center space-x-2">
                  <span class="text-xl">{stage.icon}</span>
                  <span class="font-bold text-xs text-slate-900">{stage.title}</span>
                </div>
                <span class="text-[10px] text-blue-600 font-medium mt-1">进入专区 ➔</span>
              </a>
            ))}
          </div>
        </div>

        <!-- 极速热搜推荐直达 -->
        <div class="border border-slate-200/80 rounded-2xl p-3.5 bg-slate-50/70 space-y-2.5">
          <div class="text-[11px] font-bold text-red-600 flex items-center space-x-1">
            <span>🔥</span><span>热门推荐标签</span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            <a href="/primary?q=小升初" class="px-2.5 py-1 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg text-xs font-bold text-red-700">
              🎯 小升初择校
            </a>
            <a href="/junior?q=几何压轴" class="px-2.5 py-1 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-700">
              📐 初中压轴
            </a>
            <a href="/senior?q=高考一模" class="px-2.5 py-1 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg text-xs font-bold text-blue-700">
              📈 高考一模
            </a>
            <a href="/cert?q=教师资格证" class="px-2.5 py-1 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-700">
              🧑‍🏫 教师资格证
            </a>
            <a href="/exam?q=国家公务员" class="px-2.5 py-1 bg-white hover:bg-blue-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-700">
              🏛️ 公务员国考
            </a>
            <a href="/edu?q=期末冲刺" class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg text-xs font-bold text-amber-700">
              ⚡ 期末冲刺卷
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 主体区域 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 页脚与合规免责声明（合规关键） -->
    <footer class="bg-white border-t border-slate-200 mt-16 py-12 text-sm text-slate-500">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="space-y-3 md:col-span-2">
            <div class="font-bold text-slate-800 text-base flex items-center space-x-2.5">
              <img src="/logo.svg" alt="学霸网 Logo" class="w-7 h-7 rounded-lg shadow-sm" />
              <span>学霸网 (xuebaw.com) - 专业的网盘学习备考资源站</span>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              聚焦中小学同步名校密卷、期末押题卷、奥数思维拓展及成人考证真题。所有资料均经过排版清洗，支持 A4 纸张直接打印练习，帮助家长和考生高效备考。
            </p>
          </div>
          <div>
            <div class="font-semibold text-slate-700 mb-2">快速导航</div>
            <ul class="space-y-1.5 text-xs">
              <li><a href="/primary" class="hover:text-blue-600">小学 1-6 年级期末卷</a></li>
              <li><a href="/junior" class="hover:text-blue-600">中考历年真题分类汇编</a></li>
              <li><a href="/cert" class="hover:text-blue-600">教师资格证统考笔试清单</a></li>
