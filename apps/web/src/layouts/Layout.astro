    <!-- 全局轻量微交互吐司 (Toast) 提示容器 -->
    <div id="global-toast" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 -translate-y-2 transition-all duration-300 ease-out flex items-center space-x-2 px-4 py-2.5 bg-slate-900/90 text-white text-xs sm:text-sm font-semibold rounded-2xl shadow-xl backdrop-blur-md border border-slate-700/60 max-w-sm text-center">
      <span id="global-toast-icon">🎉</span>
      <span id="global-toast-msg">已复制！</span>
    </div>

    <!-- 全局现代高颜值沉浸式操作确认对话框 (Modern Glassmorphic Confirm Dialog) -->
    <div id="global-confirm-backdrop" class="fixed inset-0 z-[120] bg-slate-900/60 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-200"></div>
    <div id="global-confirm-modal" class="fixed inset-0 z-[120] flex items-center justify-center p-4 pointer-events-none opacity-0 transition-all duration-200">
      <div class="w-full max-w-sm sm:max-w-md bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform scale-95 transition-all duration-200 pointer-events-auto p-6 space-y-4">
        <div class="flex items-start space-x-3.5">
          <div id="confirm-icon-box" class="w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 border border-amber-200/80 flex items-center justify-center text-xl shrink-0 shadow-2xs">
            ⚠️
          </div>
          <div class="min-w-0 flex-1 pt-0.5">
            <h3 id="confirm-dialog-title" class="text-base font-extrabold text-slate-900 leading-snug">
              确认操作
            </h3>
            <p id="confirm-dialog-message" class="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed whitespace-pre-line">
              您确定要继续此操作吗？
            </p>
          </div>
        </div>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          <button
            type="button"
            id="confirm-btn-cancel"
            class="px-4 py-2.5 text-xs font-semibold text-slate-600 hover:text-slate-800 bg-slate-100 hover:bg-slate-200/80 rounded-xl transition cursor-pointer"
          >
            取消
          </button>
          <button
            type="button"
            id="confirm-btn-ok"
            class="px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 rounded-xl shadow-md transition cursor-pointer"
          >
            确定
          </button>
        </div>
      </div>
    </div>

    <!-- 客户端交互逻辑核心引擎 -->
    <script is:inline>
      // 全局轻量微交互吐司
      window.showGlobalToast = function(msg, icon = '🎉', duration = 3000) {
        const toast = document.getElementById('global-toast');
        const msgEl = document.getElementById('global-toast-msg');
        const iconEl = document.getElementById('global-toast-icon');
        if (!toast || !msgEl) return;
        msgEl.innerText = msg;
        if (iconEl) iconEl.innerText = icon;
        toast.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        toast.classList.add('opacity-100', 'translate-y-0');
        clearTimeout(window.__toastTimeout);
        window.__toastTimeout = setTimeout(() => {
          toast.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
          toast.classList.remove('opacity-100', 'translate-y-0');
        }, duration);
      };

      // 全局高颜值异步确认对话框 (彻底告别丑陋的原生 confirm)
      window.showConfirmDialog = function(options = {}) {
        return new Promise((resolve) => {
          const backdrop = document.getElementById('global-confirm-backdrop');
          const modal = document.getElementById('global-confirm-modal');
          const titleEl = document.getElementById('confirm-dialog-title');
          const msgEl = document.getElementById('confirm-dialog-message');
          const okBtn = document.getElementById('confirm-btn-ok');
          const cancelBtn = document.getElementById('confirm-btn-cancel');
          const iconBox = document.getElementById('confirm-icon-box');

          if (!modal || !backdrop) {
            resolve(confirm(options.message || ''));
            return;
          }

          titleEl.textContent = options.title || '操作确认';
          msgEl.textContent = options.message || '';
          okBtn.textContent = options.confirmText || '确定';
          cancelBtn.textContent = options.cancelText || '取消';

          const type = options.type || 'warning';
          if (type === 'danger') {
            iconBox.className = 'w-11 h-11 rounded-2xl bg-rose-50 text-rose-600 border border-rose-200/80 flex items-center justify-center text-xl shrink-0 shadow-2xs';
            iconBox.textContent = options.icon || '🗑️';
            okBtn.className = 'px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 rounded-xl shadow-md transition cursor-pointer';
          } else if (type === 'warning') {
            iconBox.className = 'w-11 h-11 rounded-2xl bg-amber-50 text-amber-600 border border-amber-200/80 flex items-center justify-center text-xl shrink-0 shadow-2xs';
            iconBox.textContent = options.icon || '⚠️';
            okBtn.className = 'px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-600 hover:to-orange-700 rounded-xl shadow-md transition cursor-pointer';
          } else {
            iconBox.className = 'w-11 h-11 rounded-2xl bg-blue-50 text-blue-600 border border-blue-200/80 flex items-center justify-center text-xl shrink-0 shadow-2xs';
            iconBox.textContent = options.icon || 'ℹ️';
            okBtn.className = 'px-5 py-2.5 text-xs font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 rounded-xl shadow-md transition cursor-pointer';
          }

          function cleanup(result) {
            modal.classList.add('pointer-events-none', 'opacity-0');
            modal.querySelector('div')?.classList.add('scale-95');
            backdrop.classList.add('opacity-0', 'pointer-events-none');
            okBtn.removeEventListener('click', onOk);
            cancelBtn.removeEventListener('click', onCancel);
            backdrop.removeEventListener('click', onCancel);
            window.removeEventListener('keydown', onKeyDown);
            resolve(result);
          }

          function onOk() { cleanup(true); }
          function onCancel() { cleanup(false); }
          function onKeyDown(e) {
            if (e.key === 'Escape') onCancel();
          }

          okBtn.addEventListener('click', onOk);
          cancelBtn.addEventListener('click', onCancel);
          backdrop.addEventListener('click', onCancel);
          window.addEventListener('keydown', onKeyDown);

          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          modal.classList.remove('pointer-events-none', 'opacity-0');
          modal.querySelector('div')?.classList.remove('scale-95');
        });
      };

      document.addEventListener('DOMContentLoaded', () => {
        // ==========================================
        // 1. 移动端分类抽屉
        // ==========================================
        const openMobileBtn = document.getElementById('open-mobile-drawer');
        const openMobileSubBtn = document.getElementById('open-mobile-drawer-sub');
        const closeMobileBtn = document.getElementById('close-mobile-drawer');
        const mobileDrawer = document.getElementById('mobile-drawer');
        const mobileBackdrop = document.getElementById('mobile-drawer-backdrop');

        function openMobileDrawer() {
          mobileDrawer?.classList.remove('translate-x-full');
          mobileBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
        }
        function closeMobileDrawer() {
          mobileDrawer?.classList.add('translate-x-full');
          mobileBackdrop?.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        }
        openMobileBtn?.addEventListener('click', openMobileDrawer);
        openMobileSubBtn?.addEventListener('click', openMobileDrawer);
        closeMobileBtn?.addEventListener('click', closeMobileDrawer);
        mobileBackdrop?.addEventListener('click', closeMobileDrawer);
        mobileDrawer?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMobileDrawer));

        // ==========================================
        // 2. 备考清单 / 本地收藏夹核心引擎 (LocalStorage)
        // ==========================================
        const BOOKMARK_STORAGE_KEY = 'xueba_bookmarks';
        function getBookmarks() {
          try {
            const data = localStorage.getItem(BOOKMARK_STORAGE_KEY);
            return data ? JSON.parse(data) : [];
          } catch {
            return [];
          }
        }
        function setBookmarks(list) {
          try {
            localStorage.setItem(BOOKMARK_STORAGE_KEY, JSON.stringify(list));
            updateAllBookmarkUI();
          } catch {}
        }

        const bDrawer = document.getElementById('bookmarks-drawer');
        const bBackdrop = document.getElementById('bookmarks-backdrop');
        const bListEl = document.getElementById('bookmarks-list');

        function openBookmarksDrawer() {
          renderBookmarksList();
          bDrawer?.classList.remove('translate-x-full');
          bBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
        }
        function closeBookmarksDrawer() {
          bDrawer?.classList.add('translate-x-full');
          bBackdrop?.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        }

        document.getElementById('header-open-bookmarks')?.addEventListener('click', openBookmarksDrawer);
        document.getElementById('floating-bookmarks-btn')?.addEventListener('click', openBookmarksDrawer);
        document.getElementById('close-bookmarks-drawer')?.addEventListener('click', closeBookmarksDrawer);
        bBackdrop?.addEventListener('click', closeBookmarksDrawer);

        function updateAllBookmarkUI() {
          const list = getBookmarks();
          const count = list.length;
          // 更新所有角标
          document.querySelectorAll('.bookmark-count-badge').forEach(badge => {
            badge.textContent = count;
            if (count > 0) {
              badge.classList.remove('hidden');
            } else {
              badge.classList.add('hidden');
            }
          });

          // 更新卡片星星图标状态
          const slugSet = new Set(list.map(item => item.slug));
          document.querySelectorAll('.btn-bookmark-toggle').forEach(btn => {
            const slug = btn.getAttribute('data-slug');
            const svg = btn.querySelector('.icon-bookmark-star');
            if (!slug || !svg) return;
            if (slugSet.has(slug)) {
              btn.classList.add('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.remove('text-slate-400');
              svg.setAttribute('fill', 'currentColor');
            } else {
              btn.classList.remove('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.add('text-slate-400');
              svg.setAttribute('fill', 'none');
            }
          });
        }

        function renderBookmarksList() {
          if (!bListEl) return;
          const list = getBookmarks();
          if (list.length === 0) {
            bListEl.innerHTML = `
              <div class="text-center py-16 space-y-3">
                <div class="text-4xl">⭐️</div>
                <div class="font-bold text-slate-800 text-sm">备考清单空空如也</div>
                <p class="text-xs text-slate-400 max-w-xs mx-auto leading-relaxed">
                  在任意试卷卡片右侧点击“⭐️”图标，即可将资料收藏到此处，备考前集中转存不迷路！
                </p>
              </div>
            `;
            return;
          }

          bListEl.innerHTML = list.map((item, idx) => `
            <div class="p-3.5 bg-slate-50/80 hover:bg-slate-50 border border-slate-200/80 rounded-2xl transition space-y-2 group" data-idx="${idx}">
              <div class="flex items-start justify-between gap-2">
                <a href="${item.url}" class="text-xs font-bold text-slate-900 hover:text-blue-600 transition line-clamp-2 leading-snug">
                  ${item.title}
                </a>
                <button type="button" class="btn-remove-single-bm text-slate-400 hover:text-red-600 p-1 rounded-lg text-xs transition cursor-pointer" data-slug="${item.slug}" title="移出清单">
                  ✕
                </button>
              </div>
              <div class="flex items-center justify-between gap-2 pt-1">
                <div class="flex items-center gap-1.5 text-[10px] text-slate-400 font-mono">
                  ${item.grade ? `<span class="px-1.5 py-0.5 bg-white border border-slate-200 rounded text-slate-600">${item.grade}</span>` : ''}
                  ${item.subject ? `<span class="px-1.5 py-0.5 bg-blue-50 text-blue-700 rounded">${item.subject}</span>` : ''}
                  <span>${item.size || ''}</span>
                </div>
                <a
                  href="${item.quark || item.url}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2.5 py-1 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-[11px] font-bold transition flex items-center gap-1 shadow-2xs"
                >
                  <span>⚡</span><span>极速转存</span>
                </a>
              </div>
            </div>
          `).join('');

          // 绑定单个删除事件
          bListEl.querySelectorAll('.btn-remove-single-bm').forEach(delBtn => {
            delBtn.addEventListener('click', (e) => {
              const slug = delBtn.getAttribute('data-slug');
              const curList = getBookmarks();
              const nextList = curList.filter(item => item.slug !== slug);
              setBookmarks(nextList);
              renderBookmarksList();
              window.showGlobalToast('已移出备考清单', '🗑️');
            });
          });
        }

        // 清空备考清单
        document.getElementById('btn-clear-bookmarks')?.addEventListener('click', async () => {
          if (getBookmarks().length === 0) return;
          const ok = await window.showConfirmDialog({
            title: '清空备考清单',
            message: '确定要清空全部备考清单吗？清空后当前已保存的全部真题资料将被移除。',
            confirmText: '确定清空',
            cancelText: '取消',
            type: 'danger',
            icon: '🗑️'
          });
          if (ok) {
            setBookmarks([]);
            renderBookmarksList();
            window.showGlobalToast('备考清单已清空', '🧹');
          }
        });

        // 一键复制备考清单
        document.getElementById('btn-copy-bookmarks')?.addEventListener('click', () => {
          const list = getBookmarks();
          if (list.length === 0) {
            window.showGlobalToast('清单为空，快去添加资料吧！', 'ℹ️');
            return;
          }
          let text = `【学霸网 · 我的备考资料清单】共 ${list.length} 份精品真题资料：\n\n`;
          list.forEach((item, i) => {
            text += `${i + 1}. 《${item.title}》\n直达转存：${item.quark || (window.location.origin + item.url)}\n\n`;
          });
          text += `学霸网 (xuebaw.com) - 高清中小学名校冲刺密卷与备考资料库`;

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
              window.showGlobalToast('全部备考清单链接已复制到剪贴板！', '📋');
            });
          } else {
            window.showGlobalToast('复制成功！', '📋');
          }
        });

        // 批量打开转存
        document.getElementById('btn-batch-open-quark')?.addEventListener('click', () => {
          const list = getBookmarks();
          if (list.length === 0) {
            window.showGlobalToast('清单为空，请先添加资料！', 'ℹ️');
            return;
          }
          const links = list.map(item => item.quark).filter(url => url && url.startsWith('http'));
          if (links.length === 0) {
            window.showGlobalToast('清单内无有效网盘直达链接', '⚠️');
            return;
          }
          // 打开第一个或提示用户
          window.open(links[0], '_blank');
          if (links.length > 1) {
            window.showGlobalToast(`已打开第 1 份资料，请允许浏览器弹出窗口以继续打开其余 ${links.length - 1} 份`, '⚡');
            for (let i = 1; i < Math.min(links.length, 5); i++) {
              setTimeout(() => { window.open(links[i], '_blank'); }, i * 400);
            }
          }
        });

        // 全局代理点击卡片收藏按钮
        document.addEventListener('click', (e) => {
          const toggleBtn = e.target.closest('.btn-bookmark-toggle');
          if (!toggleBtn) return;
          e.preventDefault();
          e.stopPropagation();

          const slug = toggleBtn.getAttribute('data-slug');
          const title = toggleBtn.getAttribute('data-title');
          const url = toggleBtn.getAttribute('data-url');
          const quark = toggleBtn.getAttribute('data-quark');
          const stage = toggleBtn.getAttribute('data-stage');
          const grade = toggleBtn.getAttribute('data-grade');
          const subject = toggleBtn.getAttribute('data-subject');
          const size = toggleBtn.getAttribute('data-size');

          const curList = getBookmarks();
          const exists = curList.some(item => item.slug === slug);

          if (exists) {
            const nextList = curList.filter(item => item.slug !== slug);
            setBookmarks(nextList);
            window.showGlobalToast(`已从备考清单移出`, '⭐️');
          } else {
            curList.push({
              slug,
              title,
              url,
              quark,
              stage,
              grade,
              subject,
              size,
              addedAt: new Date().toISOString()
            });
            setBookmarks(curList);
            window.showGlobalToast(`已加入备考清单！点击右下角可随时查看`, '⭐️');
          }
        });

        // 初始化加载一次本地收藏 UI
        updateAllBookmarkUI();

        // ==========================================
        // 3. 求资料 / 找卷愿望池弹窗流程
        // ==========================================
        const reqModal = document.getElementById('request-modal');
        const reqBackdrop = document.getElementById('request-modal-backdrop');
        const reqForm = document.getElementById('request-form');
        const closeReqBtn = document.getElementById('close-request-modal');
        const cancelReqBtn = document.getElementById('cancel-request-form');
        const tabReqForm = document.getElementById('tab-req-form');
        const tabReqTrending = document.getElementById('tab-req-trending');
        const trendingContainer = document.getElementById('request-trending-container');
        const trendingLoading = document.getElementById('trending-list-loading');
        const trendingItems = document.getElementById('trending-list-items');

        function openRequestModal() {
          reqModal?.classList.remove('pointer-events-none', 'opacity-0');
          reqModal?.querySelector('div')?.classList.remove('scale-95');
          reqBackdrop?.classList.remove('opacity-0', 'pointer-events-none');
          document.body.style.overflow = 'hidden';
          switchRequestTab('form');
        }

        function closeRequestModal() {
          reqModal?.classList.add('pointer-events-none', 'opacity-0');
          reqModal?.querySelector('div')?.classList.add('scale-95');
          reqBackdrop?.classList.add('opacity-0', 'pointer-events-none');
          document.body.style.overflow = '';
        }

        document.querySelectorAll('.btn-open-request-modal').forEach(btn => {
          btn.addEventListener('click', openRequestModal);
        });
        closeReqBtn?.addEventListener('click', closeRequestModal);
        cancelReqBtn?.addEventListener('click', closeRequestModal);
        reqBackdrop?.addEventListener('click', closeRequestModal);

        function switchRequestTab(tab) {
          if (tab === 'form') {
            tabReqForm?.classList.add('border-blue-600', 'text-blue-600');
            tabReqForm?.classList.remove('border-transparent', 'text-slate-500');
            tabReqTrending?.classList.remove('border-blue-600', 'text-blue-600');
            tabReqTrending?.classList.add('border-transparent', 'text-slate-500');
            reqForm?.classList.remove('hidden');
            trendingContainer?.classList.add('hidden');
          } else {
            tabReqTrending?.classList.add('border-blue-600', 'text-blue-600');
            tabReqTrending?.classList.remove('border-transparent', 'text-slate-500');
            tabReqForm?.classList.remove('border-blue-600', 'text-blue-600');
            tabReqForm?.classList.add('border-transparent', 'text-slate-500');
            reqForm?.classList.add('hidden');
            trendingContainer?.classList.remove('hidden');
            loadTrendingRequests();
          }
        }

        tabReqForm?.addEventListener('click', () => switchRequestTab('form'));
        tabReqTrending?.addEventListener('click', () => switchRequestTab('trending'));

        // 提交表单逻辑
        reqForm?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const submitBtn = document.getElementById('submit-request-btn');
          const formData = new FormData(reqForm);
          const payload = {
            title: formData.get('title')?.trim(),
            stage: formData.get('stage')?.trim(),
            subject: formData.get('subject')?.trim(),
            description: formData.get('description')?.trim(),
            contact_info: formData.get('contact_info')?.trim()
          };

          if (!payload.title) {
            window.showGlobalToast('请填写您想要查找的资料名称！', '⚠️');
            return;
          }

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = '提交中...';
          }

          try {
            const res = await fetch('/api/v1/public/requests', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });
            const resJson = await res.json();
            if (res.ok && resJson.code === 200) {
              window.showGlobalToast('求资料心愿已提交！平台会尽快安排采编上架~', '🎉', 4000);
              reqForm.reset();
              closeRequestModal();
            } else {
              window.showGlobalToast(resJson.message || '提交失败，请稍后重试', '❌');
            }
          } catch (err) {
            window.showGlobalToast('网络请求异常，请检查连接', '❌');
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = `<span>🚀</span><span>立即提交愿望</span>`;
            }
          }
        });

        // 加载大家都在找的心愿
        async function loadTrendingRequests() {
          if (!trendingLoading || !trendingItems) return;
          trendingLoading.classList.remove('hidden');
          trendingItems.innerHTML = '';
          try {
            const res = await fetch('/api/v1/public/requests?page=1&pageSize=10');
            const resJson = await res.json();
            trendingLoading.classList.add('hidden');
            const items = Array.isArray(resJson.data) ? resJson.data : (resJson.data?.items || []);
            if (items.length === 0) {
              trendingItems.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">暂无心愿，快去提交第一个求资料吧！</div>`;
              return;
            }

            trendingItems.innerHTML = items.map(item => `
              <div class="p-3 bg-slate-50 border border-slate-200/80 rounded-2xl flex items-center justify-between gap-3 transition hover:bg-white hover:shadow-xs">
                <div class="min-w-0 flex-1 space-y-1">
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="px-1.5 py-0.2 bg-blue-50 text-blue-700 text-[10px] font-bold rounded">
                      ${item.stage || '资料'}
                    </span>
                    ${item.subject ? `<span class="px-1.5 py-0.2 bg-slate-100 text-slate-600 text-[10px] rounded">${item.subject}</span>` : ''}
                    ${item.status === 'fulfilled' ? `<span class="px-1.5 py-0.2 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded">🟢 已上架</span>` : ''}
                  </div>
                  <h4 class="text-xs font-bold text-slate-800 truncate">${item.title}</h4>
                  ${(item.note || item.description) ? `<p class="text-[11px] text-slate-400 truncate">${item.note || item.description}</p>` : ''}
                </div>
                <button
                  type="button"
                  class="btn-vote-request shrink-0 px-3 py-1.5 bg-white hover:bg-red-50 text-slate-700 hover:text-red-600 border border-slate-200 hover:border-red-200 rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-2xs cursor-pointer"
                  data-id="${item.id}"
                >
                  <span>👍</span>
                  <span>我也想要</span>
                  <span class="vote-count text-red-600 font-mono">${item.vote_count ?? item.upvotes ?? 0}</span>
                </button>
              </div>
            `).join('');

            // 附议投票按钮绑定
            trendingItems.querySelectorAll('.btn-vote-request').forEach(vBtn => {
              vBtn.addEventListener('click', async () => {
                const id = vBtn.getAttribute('data-id');
                try {
                  const voteRes = await fetch(`/api/v1/public/requests/${id}/vote`, { method: 'POST' });
                  const voteJson = await voteRes.json();
                  if (voteRes.ok && voteJson.code === 200) {
                    const countSpan = vBtn.querySelector('.vote-count');
                    if (countSpan) countSpan.textContent = voteJson.data?.upvotes || (parseInt(countSpan.textContent || '0') + 1);
                    vBtn.classList.add('bg-red-50', 'text-red-600', 'border-red-200');
                    window.showGlobalToast('已为该心愿投出 +1 附议！', '👍');
                  }
                } catch {
                  window.showGlobalToast('点赞失败，请重试', '❌');
                }
              });
            });
          } catch {
            trendingLoading.classList.remove('hidden');
            trendingLoading.textContent = '网络异常，无法加载心愿池';
          }
        }

        // 绑定全局卡片快速分享助手
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-quick-share');
          if (!btn) return;
          e.preventDefault();
          e.stopPropagation();

          const title = btn.getAttribute('data-title') || document.title;
          const path = btn.getAttribute('data-url') || window.location.pathname;
          const fullUrl = window.location.origin + path;
          const shareText = `【学霸网资料推荐】《${title}》\n高清名校试卷与备考真题，支持A4直接打印与网盘极速转存！\n直达链接：${fullUrl}`;

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(shareText).then(() => {
              window.showGlobalToast('推荐文案与链接已复制！去微信/QQ粘贴即可分享给好友', '🎉');
              const originalHtml = btn.innerHTML;
              btn.innerHTML = `<span class="text-emerald-600 font-bold text-xs flex items-center gap-0.5">✓ 已复制</span>`;
              setTimeout(() => { btn.innerHTML = originalHtml; }, 2000);
            }).catch(() => {
              window.showGlobalToast('直达链接：' + fullUrl, '🔗');
            });
          } else {
            window.showGlobalToast('直达链接：' + fullUrl, '🔗');
          }
        });

        // --- 🎁 推荐本站模态弹窗交互逻辑 ---
        const siteRecModal = document.getElementById('site-recommend-modal');
        const siteRecBackdrop = document.getElementById('site-recommend-backdrop');
        const openSiteRecBtn = document.getElementById('floating-recommend-site-btn');
        const closeSiteRecBtn = document.getElementById('close-site-recommend-modal');
        const closeSiteRecBottomBtn = document.getElementById('btn-close-site-rec-bottom');
        const siteRecTextarea = document.getElementById('site-recommend-textarea');
        const btnCopySiteRec = document.getElementById('btn-copy-site-recommend');
        const btnCopySiteUrl = document.getElementById('btn-copy-site-url');
        const siteRecTabs = document.querySelectorAll('.site-rec-tab');

        const recTemplates = {
          parent: `群里的家长们好，分享一个很实用的免费真题网站【学霸网】(https://xuebaw.com)，涵盖小学到高中的期中期末试卷、真题密卷，都是A4高清版可直接打印，有需要的可以自取或存到网盘备用~`,
          moments: `发现一个挺好用的试卷真题网站【学霸网】(https://xuebaw.com)，中小学各年级真题和微课解析挺全的，可以免费保存和A4直接打印，家里有娃备考的推荐收藏下~`,
          direct: `推荐你一个找真题试卷的网站：https://xuebaw.com （学霸网），期末考卷和解析视频都有，A4直接打印很清晰，顺手存网盘备用哈。`
        };

        let currentRecTab = 'parent';

        function updateRecText(tab) {
          currentRecTab = tab;
          if (siteRecTextarea) {
            siteRecTextarea.value = recTemplates[tab] || recTemplates.parent;
          }
          siteRecTabs.forEach(t => {
            const isCur = t.getAttribute('data-tab') === tab;
            if (isCur) {
              t.classList.add('bg-white', 'text-emerald-700', 'shadow-xs');
              t.classList.remove('text-slate-500');
            } else {
              t.classList.remove('bg-white', 'text-emerald-700', 'shadow-xs');
              t.classList.add('text-slate-500');
            }
          });
        }

        function openSiteRecModal() {
          if (!siteRecModal || !siteRecBackdrop) return;
          updateRecText(currentRecTab);
          siteRecBackdrop.classList.remove('opacity-0', 'pointer-events-none');
          siteRecBackdrop.classList.add('opacity-100', 'pointer-events-auto');
          siteRecModal.classList.remove('opacity-0', 'pointer-events-none');
          siteRecModal.classList.add('opacity-100', 'pointer-events-auto');
          siteRecModal.querySelector('.transform')?.classList.remove('scale-95');
          siteRecModal.querySelector('.transform')?.classList.add('scale-100');
          document.body.style.overflow = 'hidden';
        }

        function closeSiteRecModal() {
          if (!siteRecModal || !siteRecBackdrop) return;
          siteRecBackdrop.classList.remove('opacity-100', 'pointer-events-auto');
          siteRecBackdrop.classList.add('opacity-0', 'pointer-events-none');
          siteRecModal.classList.remove('opacity-100', 'pointer-events-auto');
          siteRecModal.classList.add('opacity-0', 'pointer-events-none');
          siteRecModal.querySelector('.transform')?.classList.remove('scale-100');
          siteRecModal.querySelector('.transform')?.classList.add('scale-95');
          document.body.style.overflow = '';
        }

        openSiteRecBtn?.addEventListener('click', openSiteRecModal);
        closeSiteRecBtn?.addEventListener('click', closeSiteRecModal);
        closeSiteRecBottomBtn?.addEventListener('click', closeSiteRecModal);
        siteRecBackdrop?.addEventListener('click', closeSiteRecModal);

        siteRecTabs.forEach(t => {
          t.addEventListener('click', () => {
            const tab = t.getAttribute('data-tab');
            if (tab) updateRecText(tab);
          });
        });

        btnCopySiteRec?.addEventListener('click', () => {
          const text = siteRecTextarea ? siteRecTextarea.value : recTemplates[currentRecTab];
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
              window.showGlobalToast('推荐文案已复制！感谢您把学霸网分享给身边的人～', '🎉');
              closeSiteRecModal();
            }).catch(() => {
              window.showGlobalToast('复制失败，请手动全选复制', '📋');
            });
          } else {
            if (siteRecTextarea) {
              siteRecTextarea.select();
              document.execCommand('copy');
              window.showGlobalToast('推荐文案已复制！感谢您把学霸网分享给身边的人～', '🎉');
              closeSiteRecModal();
            }
          }
        });

        btnCopySiteUrl?.addEventListener('click', () => {
          const url = 'https://xuebaw.com';
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(() => {
              window.showGlobalToast('官方网址已复制：' + url, '🔗');
            });
          } else {
            window.showGlobalToast('官方网址：' + url, '🔗');
          }
        });
      });
    </script>
  </body>
</html>
