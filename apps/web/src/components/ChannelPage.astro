        { drive_type: "quark", share_url: "https://pan.quark.cn/s/demo_quark_tools_ppt", is_primary: true }
      ]
    },
    {
      slug: "arcade-retro-games-500-in-1-simulator",
      channelSlug: "games",
      title: "经典怀旧街机/FC红白机500合1整合包（含全套模拟器+即开即玩即存档）",
      subtitle: "拳皇、街霸、合金弹头、恐龙快打、魂斗罗经典全收录，电脑与手机双端通用",
      stage: "通用",
