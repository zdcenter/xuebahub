---
import Layout from '../layouts/Layout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import { getApiBaseUrl } from '../lib/api';

interface ChannelItem {
  slug: string;
  name: string;
  icon: string;
  description: string;
}

interface Props {
  channelSlug?: string;
  stageSlug?: string;
}

const { channelSlug = 'all', stageSlug = '' } = Astro.props;

let channelsList: ChannelItem[] = [];
let resourcesList: any[] = [];

const url = new URL(Astro.request.url);
const stage = stageSlug || url.searchParams.get('stage') || '';
const q = url.searchParams.get('q') || '';
const school = url.searchParams.get('school') || '';
const region = url.searchParams.get('region') || '';

let isApiConnected = false;

const apiBase = getApiBaseUrl();

// 方案一：Cloudflare 边缘 CDN 极速缓存与后台静默刷新
// max-age=60 (浏览器端缓存 1 分钟)
// s-maxage=300 (Cloudflare 边缘节点新鲜期 5 分钟，全国各节点秒开直出)
// stale-while-revalidate=86400 (过期后 24 小时内后台静默异步刷新，用户永不等待卡顿)
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=60, s-maxage=300, stale-while-revalidate=86400'
);

// 1. 获取所有公开上线的频道 (动态支持后台上下线)
try {
  const chRes = await fetch(`${apiBase}/api/v1/public/channels`, { signal: AbortSignal.timeout(6000) });
  if (chRes.ok) {
    const chJson = await chRes.json();
    const rawList = Array.isArray(chJson.data) ? chJson.data : (chJson.data?.items || []);
    channelsList = rawList.map((c: any) => ({
      slug: c.slug,
      name: c.name,
      icon: c.icon,
      description: c.description
    }));
    isApiConnected = true;
  }
} catch (e) {
  console.warn("Fetch channels from Go API failed", e);
}

// 获取系统全局配置 (官方 QQ 群与加群链接)
let siteSettings = {
  qq_group: "625248438",
  qq_group_url: "https://qm.qq.com/cgi-bin/qm/qr?k=&jump_from=webapi&authKey=&uin=625248438"
};
try {
  const setRes = await fetch(`${apiBase}/api/v1/public/settings`, { signal: AbortSignal.timeout(6000) });
  if (setRes.ok) {
    const setJson = await setRes.json();
    if (setJson.data) {
      siteSettings = { ...siteSettings, ...setJson.data };
    }
  }
} catch (e) {}

// 仅在后端 API 离线连接失败时，使用本地静态备用频道
if (!isApiConnected && channelsList.length === 0) {
  channelsList = [
    { slug: 'edu', name: '刚需教辅学习', icon: '📚', description: '中小学同步名校密卷、期末押题、奥数培优与教资考公真题' }
  ];
}

// 校验当前频道是否合法（如果后台已将该频道隐藏或下线，访问时直接 302 重定向到首页）
const isAll = channelSlug === 'all' || !channelSlug;
const activeChannel = channelsList.find(c => c.slug === channelSlug);
if (!isAll && isApiConnected && !activeChannel) {
  return Astro.redirect('/', 302);
}

// 2. 从 Go Fiber API 动态拉取实时数据 (根据频道、学段、学校与关键词过滤)
try {
  let fetchUrl = `${apiBase}/api/v1/public/resources?limit=24`;
  if (!isAll) {
    fetchUrl += `&channel=${encodeURIComponent(channelSlug)}`;
  }
  if (stage && stage !== 'all') {
    fetchUrl += `&stage=${encodeURIComponent(stage)}`;
  }
  if (school) {
    fetchUrl += `&school=${encodeURIComponent(school)}`;
  }
  if (region) {
    fetchUrl += `&region=${encodeURIComponent(region)}`;
  }
  if (q) {
    fetchUrl += `&q=${encodeURIComponent(q)}`;
  }

  const response = await fetch(fetchUrl, { signal: AbortSignal.timeout(6000) });
  if (response.ok) {
    const json = await response.json();
    resourcesList = (json.data?.items || []).map((item: any) => ({
      slug: item.slug,
      channelSlug: item.channel_slug || 'edu',
      title: item.title,
      subtitle: item.subtitle,
      stage: item.stage,
      grade: item.grade,
      subject: item.subject,
      edition: item.edition,
      region: item.region || '',
      school: item.school || '',
      coverImage: item.cover_image || "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&auto=format&fit=crop&q=80",
      fileType: item.file_type || "PDF",
      fileSize: item.file_size || "15 MB",
      pageCount: item.page_count || 0,
      createdAt: item.created_at || '',
      viewCount: item.view_count || 0,
      saveCount: item.save_count || 0,
      isRecommended: item.is_recommended,
      links: (item.links || []).map((l: any) => ({
        drive_type: l.drive_type,
        share_url: l.share_url,
        extract_code: l.extract_code,
        password_hint: l.password_hint,
        is_primary: l.is_primary
      }))
    }));
  }
} catch (e) {
  console.warn("Fetch from Go API failed, using fallback data", e);
}

// 3. 从 Go API 动态拉取当前专区的高频热搜标签 (支持后台实时配置)
interface HotSearchItem {
  id: string;
  title: string;
  keyword: string;
  stage: string;
  style_type: string;
  sort_order: number;
}
let dynamicHotSearches: HotSearchItem[] = [];

try {
  const currentStageParam = stageSlug || (channelSlug !== 'all' ? channelSlug : 'all');
  const hsRes = await fetch(`${apiBase}/api/v1/public/hot-searches?stage=${encodeURIComponent(currentStageParam)}`, { signal: AbortSignal.timeout(4000) });
  if (hsRes.ok) {
    const hsJson = await hsRes.json();
    dynamicHotSearches = hsJson.data || [];
  }
} catch (e) {
  console.warn("Fetch hot searches failed, fallback will be used", e);
}

// 仅在后端 API 离线连接失败时，使用兜底备用数据（保证离线与SSG构建绝对安全）
if (!isApiConnected && resourcesList.length === 0) {
  const allFallbacks = [
    {
      slug: "2026-senior-math-function-video-special",
      channelSlug: "edu",
      title: "2026高考数学压轴导数与函数极值满分突破（含120分钟名师手撕解题高清视频课）",
      subtitle: "高中拔高提分必备，包含5套名校压轴题及手写规范作答步骤PDF + 高清精讲视频",
      stage: "高中专区",
      grade: "高三",
      subject: "数学",
      edition: "新高考通用",
      coverImage: "https://images.unsplash.com/photo-1596495578065-6e0763fa1178?w=600&auto=format&fit=crop&q=80",
      fileType: "PDF+MP4视频",
      fileSize: "240 MB",
      pageCount: 32,
      viewCount: 1680,
      saveCount: 520,
      isRecommended: true,
      links: [
        { drive_type: "quark", share_url: "https://pan.quark.cn/s/demo_quark_senior_video", is_primary: true }
      ]
    },
    {
      slug: "2026-spring-grade3-math-final-exam",
      channelSlug: "edu",
      title: "2026春季人教版三年级下册数学期末冲刺夺冠押题卷（含高清解析与手写步骤）",
      subtitle: "名校名师联合精选必考压轴题，覆盖乘除法、面积计算、小数初步",
      stage: "primary",
      grade: "三年级",
      subject: "数学",
      edition: "人教版",
      coverImage: "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&auto=format&fit=crop&q=80",
      fileType: "PDF",
      fileSize: "12.4 MB",
      pageCount: 28,
      viewCount: 1520,
      saveCount: 468,
      isRecommended: true,
      links: [
        { drive_type: "quark", share_url: "https://pan.quark.cn/s/demo_quark_share", is_primary: true }
      ]
    },
    {
      slug: "2026-junior-math-geometry-breakthrough",
      channelSlug: "edu",
      title: "2026年中考数学几何辅助线添法压轴专题精讲（含圆与相似三角形12大解题模型）",
      subtitle: "历年中考压轴得分利器，涵盖全等辅助线、旋转变换与隐形圆经典题型",
      stage: "junior",
      grade: "初三/中考",
      subject: "数学",
      edition: "人教版统编",
      coverImage: "https://images.unsplash.com/photo-1596495578065-6e0763fa1178?w=600&auto=format&fit=crop&q=80",
      fileType: "PDF",
      fileSize: "18.6 MB",
      pageCount: 64,
      viewCount: 3410,
      saveCount: 1280,
      isRecommended: true,
      links: [
        { drive_type: "quark", share_url: "https://pan.quark.cn/s/demo_quark_share", is_primary: true }
      ]
    },
    {
      slug: "2026-senior-math-derivative-master",
      channelSlug: "edu",
      title: "2026年新高考数学导数切线与极值点偏移压轴大题深度破解手册（附全彩思维导图）",
      subtitle: "百强名校命题组深度联合编写，彻底解决导数单调性分类讨论与不等式恒成立难题",
      stage: "senior",
      grade: "高三/高考",
      subject: "数学",
      edition: "新高考全国卷",
      coverImage: "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&auto=format&fit=crop&q=80",
      fileType: "PDF",
      fileSize: "24.5 MB",
      pageCount: 88,
      viewCount: 4890,
      saveCount: 1850,
      isRecommended: true,
      links: [
        { drive_type: "quark", share_url: "https://pan.quark.cn/s/demo_quark_share", is_primary: true }
      ]
    }
  ];

  if (!isAll) {
    resourcesList = allFallbacks.filter(item => item.channelSlug === channelSlug);
  } else {
    resourcesList = allFallbacks;
  }
}

// 针对不同频道的专业 SEO TDK 深度定制
let seoTitle = "学霸网 - 中小学同步教辅、考试真题与网盘学习资源平台";
let seoDesc = "学霸网 (xuebaw.com) 严选中小学人教版同步期末密卷、名校压轴真题、奥数培优与教师资格证/公考备考真题，支持A4高清打印与高速一键转存。";
let seoKeywords = "学霸网,xuebaw.com,网盘资源,中小学试卷下载,期末冲刺卷,中考真题,高考模拟卷,教师资格证真题,公务员备考,夸克网盘转存";
let heroTitle = "中小学名校期末密卷 & 升学考试真题精选库";
let heroSubtitle = "严选人教版同步压轴真题、名校期末冲刺卷与教资公考刚需备考资料，一键极速转存。";
let heroBadge = "✨ 2026 全域学霸真题 · 高清排版 · 每日巡检";
let searchPlaceholder = "输入年级、科目或考点，如：三年级数学期末、中考几何压轴、教资科目二...";

if (stageSlug === 'primary' || (!stageSlug && stage === 'primary')) {
  seoTitle = "小学同步名校期末冲刺密卷与奥数培优 - 学霸网小学专区";
  seoDesc = "学霸网免费提供人教版/北师大版小学1-6年级数学、语文、英语名校期末冲刺押题密卷、小升初分班卷与奥数微课动画，A4排版直接打印。";
  seoKeywords = "学霸网,小学试卷下载,小升初真题,人教版小学数学,小学奥数,期末冲刺卷,小学微课视频";
  heroTitle = "小学同步名校密卷 & 奥数思维培优专区";
  heroSubtitle = "涵盖人教版/北师大版 1-6 年级期末押题密卷、小升初分班卷与趣味奥数动画微课，一键极速转存。";
  heroBadge = "🎒 小学专区 · 1-6年级同步 · 名校期末分班密卷";
  searchPlaceholder = "输入年级或考点，如：三年级数学下册、小升初择校、奥数培优...";
} else if (stageSlug === 'junior' || (!stageSlug && stage === 'junior')) {
  seoTitle = "初中名校期末密卷与中考历年真题分类汇编 - 学霸网初中专区";
  seoDesc = "学霸网提供初一至初三年级同步名校期末卷、中考历年分类汇编真题、几何与二次函数压轴题、物理化学实验大突破。";
  seoKeywords = "学霸网,初中试卷下载,中考真题,中考压轴题,初中数学几何,初二物理,人教版初中教辅";
  heroTitle = "初中中考全科名校密卷 & 压轴专题突围专区";
  heroSubtitle = "涵盖七八九年级同步期末卷、中考历年真题分类汇编、数学圆与函数压轴、物理电学实验突破。";
  heroBadge = "📘 初中专区 · 中考总复习 · 几何函数压轴专项";
  searchPlaceholder = "输入初中年级或考点，如：初二物理、几何压轴、中考数学真题...";
} else if (stageSlug === 'senior' || (!stageSlug && stage === 'senior')) {
  seoTitle = "2026新高考名校模拟试卷与导数圆锥曲线专项 - 学霸网高中专区";
  seoDesc = "学霸网精选九省联考/八省联考、百强名校一模二模新高考模拟试卷、导数与圆锥曲线大招微课、学霸手撕笔记。";
  seoKeywords = "学霸网,新高考模拟卷,高中试卷下载,九省联考真题,高考数学导数,高考圆锥曲线,学霸笔记";
