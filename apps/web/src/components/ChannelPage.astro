  heroBadge = "🎓 高中专区 · 2026新高考模考 · 导数圆锥曲线大招";
  searchPlaceholder = "输入高中文理科目或考点，如：新高考一模、导数极值、圆锥曲线...";
} else if (stageSlug === 'cert' || (!stageSlug && stage === 'cert')) {
  seoTitle = "教师资格证统考笔试面试核心备考真题与速记口诀 - 学霸网考证专区";
  seoDesc = "学霸网提供中学/小学教师资格证统考综合素质、教育知识与能力、学科知识与教学能力、结构化面试高频口诀与教案。";
  seoKeywords = "学霸网,教师资格证真题,教资科目一,教资科目二,教资面试试讲,普通话考试,教师资格证题库";
  heroTitle = "考证专区 & 教师资格证统考笔试面试核心真题";
  heroSubtitle = "涵盖小学/中学教资综合素质、教育知识与能力、学科知识科三、结构化面试精讲与通关背诵口诀。";
  heroBadge = "📋 考证专区 · 教师资格证统考 · 笔试面试通关必备";
  searchPlaceholder = "输入考证类别，如：中学综合素质、教育知识与能力、结构化面试...";
} else if (stageSlug === 'exam' || (!stageSlug && stage === 'exam')) {
  seoTitle = "国家公务员考试行测申论与考研公共课真题 - 学霸网公考升学专区";
  seoDesc = "学霸网提供国家公务员国考/省考行测高频速算与申论热点范文、全国硕士研究生统考政治英语核心背诵与高分笔记。";
  seoKeywords = "学霸网,公务员国考真题,行测技巧,申论范文,考研政治背诵,考研英语长难句,考研数学";
  heroTitle = "国家公务员与升学统考公共课备考专区";
  heroSubtitle = "汇集国考省考行测申论热点、考研政治英语数学核心背诵与高频错题速算技巧。";
  heroBadge = "🏛️ 公考升学 · 国考省考行测申论 · 笔试面试冲刺";
  searchPlaceholder = "输入考公升学类别，如：国考申论、行测速算、考研政治、考研英语...";
} else if (channelSlug === 'edu') {
  seoTitle = "中小学名校期末密卷与成人考证真题库 - 学霸网教辅专区";
  seoDesc = "学霸网免费提供小学、初中、高中名校期末冲刺卷、人教版同步押题密卷、奥数思维拓展及教师资格证/考公考研核心笔记，A4高清打印。";
  seoKeywords = "学霸网,期末冲刺卷,中小学试卷下载,人教版同步教辅,小学奥数,教师资格证真题,高考压轴数学,夸克网盘学习资料";
  heroTitle = "中小学名校期末密卷 & 成人考证真题库";
  heroSubtitle = "严选人教版/北师大版同步压轴真题与教师资格/考公冲刺笔记，配高清手写步骤与思维导图，一键极速转存。";
  heroBadge = "📚 刚需教辅 · A4高清排版 · 名校真题解析";
  searchPlaceholder = "输入科目、年级或考试关键词，如：三年级数学期末、教资科二、申论...";
}

// 学段与年级分类列表（直达全新独立根路由）
const stages = [
  { id: "all", name: "全部阶段", href: "/" },
  { id: "primary", name: "小学阶段 (1-6年级)", href: "/primary" },
  { id: "junior", name: "初中中考冲刺", href: "/junior" },
  { id: "senior", name: "高中高考专项", href: "/senior" },
  { id: "cert", name: "教师资格证", href: "/cert" },
  { id: "exam", name: "公考升学专区", href: "/exam" }
];

// 计算当前页面基础路径（用于搜索与过滤拼接，优先使用独立专区路径）
const basePath = isAll ? '/' : (stageSlug ? `/${stageSlug}` : `/${channelSlug}`);

// 若指定了名校或考区筛选，动态增强 SEO 与 H1 核心表意
if (school) {
  seoTitle = `${school}期中期末真题试卷与名校押题密卷 - 学霸网名校题库`;
  seoDesc = `学霸网权威收录${school}最新历年期中、期末冲刺卷、月考及中高考模拟押题，包含名师手写规范作答与评分标准，原画免密下载。`;
  heroTitle = `${school} · 重点名校试卷真题库`;
  heroSubtitle = `精选${school}历年期中期末、月考摸底及专项拔高密卷，已聚合在库资源一键极速转存。`;
  heroBadge = `🏫 名校专区 · ${school}`;
} else if (region) {
  seoTitle = `${region}中小学期中期末真题与备考资料 - 学霸网`;
  heroTitle = `${region} · 属地真题与考点题库`;
  heroBadge = `📍 属地专区 · ${region}`;
}
---

<Layout 
  title={seoTitle} 
  description={seoDesc} 
  keywords={seoKeywords}
  canonicalUrl={`${url.origin}${basePath}`}>
  
  <!-- 头部搜索区域：精简紧凑、聚焦搜索与高频热搜 -->
  <section class="bg-gradient-to-b from-blue-50/70 via-white to-slate-50/80 pt-6 pb-5 sm:pt-7 sm:pb-6 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <!-- 语义化紧凑 H1：保留搜索引擎核心抓取权重，不占首屏视觉空间 -->
      <h1 class="sr-only">
        {heroTitle} - {heroSubtitle}
      </h1>

      <!-- 全局即时搜索条 (直达干净静态路径) -->
      <div id="search-box" class="max-w-3xl mx-auto">
        <form action={basePath} method="GET" class="relative flex items-center shadow-xs rounded-2xl">
          <input
            type="text"
            name="q"
            value={q}
            placeholder={searchPlaceholder}
            class="w-full pl-12 pr-28 py-3.5 bg-white rounded-2xl border-2 border-slate-200/90 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none text-sm transition text-slate-800 placeholder:text-slate-400 font-medium"
          />
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 absolute left-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <button
            type="submit"
            class="absolute right-2 px-5 py-2 bg-blue-600 hover:bg-blue-700 active:scale-95 text-white rounded-xl text-xs font-bold shadow-sm transition-all cursor-pointer flex items-center space-x-1"
          >
            <span>快速搜索</span>
          </button>
        </form>

        <!-- 热门搜索推荐词 (100% 由后台高频热搜数据库管理驱动，停用或为空时完全隐藏，绝无硬编码) -->
        {dynamicHotSearches.length > 0 && (
          <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mt-3 text-xs text-slate-500">
            <span class="font-bold text-slate-400 flex items-center space-x-1 text-[11px] shrink-0 mr-0.5 select-none">
              <span>🔥</span>
              <span>高频热搜:</span>
            </span>
            {dynamicHotSearches.map((item) => (
              <a
                href={`${basePath}${basePath.includes('?') ? '&' : '?'}q=${encodeURIComponent(item.keyword)}`}
                class:list={['hot-search-pill', item.style_type]}
              >
                {item.title}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 核心资料流与筛选 -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- 1. 业务顶级频道导航条 (仅在多频道时展示，单频道模式下自动精简) -->
    {channelsList.length > 1 && (
      <div class="flex items-center space-x-2.5 overflow-x-auto pb-3 border-b border-slate-200 no-scrollbar">
        <span class="text-xs font-bold text-slate-400 whitespace-nowrap flex items-center gap-1">
          <span>🏷️</span> 频道:
        </span>
        <a
          href="/"
          class={`whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 ${
            isAll
              ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/20'
              : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
          }`}
        >
          <span>🌐</span>
          <span>全域资源</span>
        </a>
        {channelsList.map((ch) => {
          const cleanName = ch.name.replace(/^[\s\p{Emoji}\uFE0F]+/u, '').trim();
          return (
            <a
              href={`/${ch.slug}`}
              class={`whitespace-nowrap px-4 py-2 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 ${
                channelSlug === ch.slug
                  ? 'bg-blue-600 text-white shadow-sm shadow-blue-500/20'
                  : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
              }`}
            >
              <span>{ch.icon}</span>
              <span>{cleanName}</span>
            </a>
          );
        })}
      </div>
    )}

    <!-- 2. 核心学段专区切换栏 (直达全新独立根路由) -->
    <div class="flex items-center space-x-2 overflow-x-auto pb-2 no-scrollbar">
      <span class="text-xs font-bold text-slate-400 whitespace-nowrap flex items-center gap-1">
        <span>🏷️</span> 学段专区:
      </span>
      {stages.map((st) => {
        const isCurrentActive = stageSlug
          ? stageSlug === st.id
          : (stage === st.id || (!stage && st.id === 'all'));
        return (
          <a
            href={st.id === 'all' ? '/' : `/${st.id}`}
            class={`whitespace-nowrap px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1 ${
              isCurrentActive
                ? 'bg-blue-600 text-white shadow-xs'
                : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
            }`}
          >
            {st.name}
          </a>
        );
      })}
    </div>

    <!-- 名校/考区筛选激活状态提示横幅 -->
    {school && (
      <div class="flex items-center justify-between p-3.5 sm:p-4 bg-indigo-50/80 border border-indigo-200/90 rounded-2xl shadow-xs">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="text-xl shrink-0">🏫</span>
          <div class="min-w-0">
            <div class="text-sm font-bold text-indigo-950 flex items-center gap-2">
              <span>正在查阅「{school}」专区真题密卷</span>
              <span class="text-[11px] bg-indigo-200/80 text-indigo-900 px-2 py-0.5 rounded-full font-semibold shrink-0">
                {resourcesList.length} 份在库试卷
              </span>
            </div>
            <p class="text-xs text-indigo-600/90 truncate">已聚合该校各年级、各学科期中期末真题及名校押题试卷</p>
          </div>
        </div>
        <a
          href={basePath}
          class="shrink-0 ml-3 px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-xs"
        >
          <span>✕</span>
          <span>清除名校筛选</span>
        </a>
      </div>
    )}
    {!school && region && (
      <div class="flex items-center justify-between p-3.5 sm:p-4 bg-sky-50/80 border border-sky-200/90 rounded-2xl shadow-xs">
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="text-xl shrink-0">📍</span>
          <div class="min-w-0">
            <div class="text-sm font-bold text-sky-950 flex items-center gap-2">
              <span>正在查阅「{region}」考区真题资源</span>
              <span class="text-[11px] bg-sky-200/80 text-sky-900 px-2 py-0.5 rounded-full font-semibold shrink-0">
                {resourcesList.length} 份在库资料
              </span>
            </div>
          </div>
        </div>
        <a
          href={basePath}
          class="shrink-0 ml-3 px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-xs"
        >
          <span>✕</span>
          <span>清除地区筛选</span>
        </a>
      </div>
    )}

    <!-- 3. 资源目录总控信息条 (增强专业站权威质感) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-1 py-1 text-xs">
      <div class="flex items-center space-x-2 font-medium text-slate-700">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        <span>在库收录资源：<strong class="text-blue-700 font-bold">{resourcesList.length}</strong> 套优质资源</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-500">按转存热度与权威版本排序</span>
      </div>

      <div class="flex items-center space-x-3 text-slate-500 text-[11px]">
        <span class="flex items-center gap-1">
          <span class="text-emerald-500 font-bold">✓</span> 夸克网盘原画极速转存
        </span>
        <span class="hidden md:inline-flex items-center gap-1">
          <span class="text-blue-500 font-bold">✓</span> 每日自动化巡检存活
        </span>
        <span class="flex items-center gap-1">
          <span class="text-amber-500 font-bold">✓</span> 100% 免解压密码
        </span>
      </div>
    </div>

    <!-- 4. 高信息密度专业资源条目流 (无冗余图片，全信息高密度呈现) -->
    {resourcesList.length === 0 ? (
      <div class="text-center py-16 bg-white rounded-3xl border border-slate-200 p-8 space-y-4 shadow-sm">
        <div class="text-5xl">🔍</div>
        <h3 class="text-lg font-bold text-slate-800">暂未找到符合条件的资源</h3>
        <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
          该频道资源正在紧锣密鼓上架中，您可以切换其他频道浏览，或加入备考群联系管理员优先上架。
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a href="/" class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
            返回浏览全部资源 ➔
          </a>
          <button type="button" class="btn-open-request-modal px-5 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs font-bold rounded-xl shadow-md hover:shadow-lg transition cursor-pointer flex items-center gap-1.5">
            <span>📝</span>
            <span>没找到？提交求资料心愿</span>
          </button>
        </div>
      </div>
    ) : (
      <div class="space-y-3">
        {resourcesList.map((res) => (
          <ResourceCard {...res} />
        ))}
      </div>
    )}

    <!-- QQ 官方备考交流群 & 防走失温馨小贴士 (低调克制、不喧宾夺主) -->
    <div class="mt-8 bg-slate-50/75 hover:bg-slate-50 border border-slate-200/80 rounded-2xl p-4 sm:p-4.5 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-4 transition-colors">
      <div class="flex items-center space-x-3 text-center sm:text-left">
        <div class="w-8 h-8 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-sm text-blue-600 shrink-0">
          🐧
        </div>
        <div class="space-y-0.5">
          <div class="flex items-center space-x-2 justify-center sm:justify-start">
            <span class="text-xs sm:text-sm font-bold text-slate-800">官方备考交流 & 补链防走失群</span>
            <span class="text-[10px] text-slate-400 font-mono hidden md:inline">#防失联求档</span>
          </div>
          <p class="text-[11px] text-slate-500 leading-normal">
            若遇到网盘链接失效、需要特定试卷求档或反馈，可加入备考群即时沟通
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-center">
        <button
          type="button"
          id="btn-copy-qq-group"
          data-group={siteSettings.qq_group}
          class="px-3.5 py-1.5 bg-white hover:bg-blue-50 text-slate-700 hover:text-blue-600 active:scale-95 transition-all rounded-xl border border-slate-200/90 text-xs font-semibold shadow-2xs flex items-center space-x-1.5 cursor-pointer"
          title="点击复制群号"
        >
          <span>📋</span>
          <span>群号：<span class="font-mono font-bold text-slate-900">{siteSettings.qq_group}</span></span>
        </button>
        <a
          href={siteSettings.qq_group_url || `https://qm.qq.com/cgi-bin/qm/qr?k=&jump_from=webapi&authKey=&uin=${siteSettings.qq_group}`}
          target="_blank"
          rel="noopener noreferrer"
          id="btn-join-qq-group"
          class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-xl text-xs font-semibold border border-blue-100 transition-colors flex items-center space-x-1"
        >
          <span>一键加群 ➔</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('btn-copy-qq-group');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const groupNum = copyBtn.getAttribute('data-group') || '625248438';
        try {
          await navigator.clipboard.writeText(groupNum);
          if (window.showGlobalToast) {
            window.showGlobalToast(`QQ群号 ${groupNum} 已复制，去QQ搜索即可加入！`, '🐧');
          }
          const originalHTML = copyBtn.innerHTML;
          copyBtn.innerHTML = `<span>✓</span><span>群号已复制：${groupNum}</span>`;
          setTimeout(() => {
            copyBtn.innerHTML = originalHTML;
          }, 2000);
        } catch (err) {
          const input = document.createElement('input');
          input.value = groupNum;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
          if (window.showGlobalToast) {
            window.showGlobalToast(`QQ群号 ${groupNum} 已复制！`, '🐧');
          }
        }
      });
    }
  });
</script>

