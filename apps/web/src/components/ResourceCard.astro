---
interface ResourceLink {
  drive_type: string;
  share_url: string;
  extract_code?: string;
  password_hint?: string;
  is_primary: boolean;
}

interface Props {
  slug: string;
  title: string;
  subtitle?: string;
  stage: string;
  grade?: string;
  subject?: string;
  edition?: string;
  coverImage?: string;
  fileType?: string;
  fileSize?: string;
  pageCount?: number;
  viewCount: number;
  saveCount: number;
  isRecommended?: boolean;
  links?: ResourceLink[];
}

const {
  slug,
  title,
  subtitle,
  stage,
  grade,
  subject,
  edition,
  coverImage = "https://images.unsplash.com/photo-1509062522246-3755977927d7?w=600&auto=format&fit=crop&q=80",
  fileType = "PDF",
  fileSize = "12.5 MB",
  pageCount = 28,
  viewCount = 1200,
  saveCount = 380,
  isRecommended = false,
  links = []
} = Astro.props;

// 主推夸克链接
const primaryLink = links.find(l => l.drive_type === 'quark') || links[0] || {
  drive_type: 'quark',
  share_url: '#',
  is_primary: true
};
---

<article class="paper-card rounded-2xl overflow-hidden flex flex-col group relative bg-white">
  {isRecommended && (
    <div class="absolute top-3 left-3 z-10 bg-amber-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-md flex items-center space-x-1">
      <span>🔥 名师精选</span>
    </div>
  )}

  {(fileType?.includes('视频') || fileType?.includes('MP4')) && (
    <div class="absolute top-3 right-3 z-10 bg-red-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-full shadow-md flex items-center space-x-1 animate-pulse">
      <span>🎥 含高清视频</span>
    </div>
  )}

  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 cursor-pointer">
    <a href={`/resource/${slug}`}>
      <img
        src={coverImage}
        alt={title}
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
      
      <!-- 试卷标签 -->
      <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-xs text-white">
        <span class="bg-black/40 backdrop-blur-md px-2 py-0.5 rounded font-mono font-medium">
          {pageCount} 页可打印 · {fileType}
        </span>
        <span class="bg-emerald-600/90 backdrop-blur-md px-2 py-0.5 rounded font-medium">
          含参考答案
        </span>
      </div>
    </a>
  </div>

  <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between space-y-3">
    <!-- 分类与学科标签 -->
    <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
      {grade && (
        <span class="px-2 py-0.5 bg-blue-50 text-blue-700 font-medium rounded-md">
          {grade}
        </span>
      )}
      {subject && (
        <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 font-medium rounded-md">
          {subject}
        </span>
      )}
      {edition && (
        <span class="px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md">
          {edition}
        </span>
      )}
    </div>

    <!-- 资料标题 -->
    <div>
      <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-2 text-base leading-snug">
        <a href={`/resource/${slug}`}>
          {title}
        </a>
      </h3>
      {subtitle && (
        <p class="text-xs text-slate-500 line-clamp-1 mt-1">
          {subtitle}
        </p>
      )}
    </div>

    <!-- 转存数据统计与大小 -->
    <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center space-x-3">
        <span>大小：{fileSize}</span>
        <span>•</span>
        <span class="text-blue-600 font-medium">{saveCount} 人已转存</span>
      </div>
    </div>

    <!-- 转存与详情行动区 -->
    <div class="grid grid-cols-2 gap-2 pt-1">
      <a
        href={`/resource/${slug}`}
        class="text-center py-2 px-3 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition"
      >
        查看试卷试看
      </a>
      <a
        href={primaryLink.share_url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-save-quark text-center py-2 px-3 text-xs font-bold text-white rounded-xl shadow-sm flex items-center justify-center space-x-1"
      >
        <span>⚡ 夸克极速转存</span>
      </a>
    </div>
  </div>
</article>
