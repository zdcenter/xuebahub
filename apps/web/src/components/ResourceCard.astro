---
interface ResourceLink {
  drive_type: string;
  share_url: string;
  extract_code?: string;
  password_hint?: string;
  is_primary: boolean;
  file_type?: string;
  file_size?: string;
  resource_desc?: string;
}

interface Props {
  slug: string;
  channelSlug?: string;
  title: string;
  subtitle?: string;
  stage: string;
  grade?: string;
  subject?: string;
  edition?: string;
  coverImage?: string;
  fileType?: string;
  fileSize?: string;
  pageCount?: number;
  viewCount: number;
  saveCount: number;
  isRecommended?: boolean;
  region?: string;
  school?: string;
  links?: ResourceLink[];
}

const {
  slug,
  channelSlug,
  title,
  subtitle,
  stage,
  grade,
  subject,
  edition,
  region,
  school,
  fileType = "PDF",
  fileSize = "12.5 MB",
  pageCount = 28,
  viewCount = 1200,
  saveCount = 380,
  isRecommended = false,
  links = []
} = Astro.props;

const channelInfo: Record<string, { name: string; icon: string; bg: string; text: string; border: string }> = {
  edu: { name: '教辅备考', icon: '📚', bg: 'bg-blue-50', text: 'text-blue-700', border: 'border-blue-200' },
  tools: { name: '实用素材', icon: '🎨', bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200' },
  games: { name: '怀旧单机', icon: '🎮', bg: 'bg-purple-50', text: 'text-purple-700', border: 'border-purple-200' }
};
const currentCh = channelSlug ? channelInfo[channelSlug] : null;

// 主推夸克链接与备用百度
const primaryLink = links.find(l => l.drive_type === 'quark') || links[0] || {
  drive_type: 'quark',
  share_url: '#',
  is_primary: true
};
const hasBaidu = links.some(l => l.drive_type === 'baidu');

// 智能推导格式与类型（精准优先识别视频微课与多格式）
const rawType = (fileType || '').toUpperCase();
const linkHasVideo = links.some(l => 
  (l.file_type && (l.file_type.includes('视频') || l.file_type.toUpperCase().includes('MP4'))) || 
  (l.resource_desc && l.resource_desc.includes('视频'))
);

const isVideo = rawType.includes('视频') || rawType.includes('MP4') || linkHasVideo;
const isPdf = rawType.includes('PDF');
const isPpt = rawType.includes('PPT');
const isZip = rawType.includes('ZIP') || rawType.includes('RAR') || rawType.includes('7Z') || rawType.includes('游戏') || channelSlug === 'games';
---

<article class="resource-row-card bg-white rounded-2xl border border-slate-200/90 shadow-[0_2px_8px_-2px_rgba(15,23,42,0.06),0_4px_16px_-4px_rgba(15,23,42,0.04)] hover:shadow-[0_12px_28px_-6px_rgba(15,23,42,0.12),0_4px_12px_-2px_rgba(15,23,42,0.06)] hover:border-blue-400 hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col lg:flex-row lg:items-center justify-between group">
  <!-- 左侧：类型图标徽标 + 中间信息密集流 -->
  <div class="p-4 sm:p-5 flex items-start space-x-3.5 sm:space-x-4 flex-1 min-w-0">
    <!-- 专属类型特征徽章 (替代大面积缩略图) -->
    <div 
      class="flex-shrink-0 flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br border text-center shadow-xs group-hover:scale-105 transition-all"
      class:list={[
        isVideo ? 'from-blue-50 to-indigo-100/70 border-blue-200 group-hover:border-blue-400' :
        isPpt ? 'from-amber-50 to-orange-100/70 border-amber-200 group-hover:border-amber-400' :
        isZip ? 'from-purple-50 to-violet-100/70 border-purple-200 group-hover:border-purple-400' :
        isPdf ? 'from-rose-50 to-red-100/70 border-rose-200 group-hover:border-red-400' :
        'from-slate-50 to-blue-50/70 border-slate-200 group-hover:border-blue-300'
      ]}
    >
      {isVideo ? (
        <div class="flex flex-col items-center">
          <span class="text-xl leading-none">🎬</span>
          <span class="text-[10px] font-mono font-bold mt-1 text-blue-700">
            {isPdf ? 'MP4+PDF' : 'MP4视频'}
          </span>
        </div>
      ) : isPpt ? (
        <div class="flex flex-col items-center">
          <span class="text-xl leading-none">📑</span>
          <span class="text-[10px] font-mono font-bold mt-1 text-amber-700">PPTX</span>
        </div>
      ) : isZip ? (
        <div class="flex flex-col items-center">
          <span class="text-xl leading-none">📦</span>
          <span class="text-[10px] font-mono font-bold mt-1 text-purple-700">ZIP</span>
        </div>
      ) : isPdf ? (
        <div class="flex flex-col items-center">
          <span class="text-xl leading-none">📄</span>
          <span class="text-[10px] font-mono font-bold mt-1 text-rose-600">PDF</span>
        </div>
      ) : (
        <div class="flex flex-col items-center">
          <span class="text-xl leading-none">{currentCh ? currentCh.icon : '📁'}</span>
          <span class="text-[10px] font-mono font-bold mt-1 text-slate-700">{fileType || 'DATA'}</span>
        </div>
      )}
    </div>

    <!-- 资料详情本体 -->
    <div class="flex-1 min-w-0 space-y-1.5">
      <!-- 标签与状态流 -->
      <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
        {currentCh && (
          <span class={`px-2 py-0.5 ${currentCh.bg} ${currentCh.text} border ${currentCh.border} font-bold rounded-md flex items-center gap-1`}>
            <span>{currentCh.icon}</span>
            <span>{currentCh.name}</span>
          </span>
        )}
        {grade && (
          <span class="px-2 py-0.5 bg-slate-100 text-slate-700 font-medium rounded-md">
            {grade}
          </span>
        )}
        {subject && (
          <span class="px-2 py-0.5 bg-blue-50 text-blue-700 font-medium rounded-md">
            {subject}
          </span>
        )}
        {edition && (
          <span class="px-2 py-0.5 bg-slate-50 text-slate-500 rounded-md border border-slate-200">
            {edition}
          </span>
        )}
        {school ? (
          <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 border border-indigo-200 font-medium rounded-md flex items-center gap-0.5">
            <span>🏫</span>
            <span>{school}</span>
          </span>
        ) : region ? (
          <span class="px-2 py-0.5 bg-sky-50 text-sky-700 border border-sky-200 font-medium rounded-md flex items-center gap-0.5">
            <span>📍</span>
            <span>{region}</span>
          </span>
        ) : null}
        {isRecommended && (
          <span class="px-2 py-0.5 bg-amber-50 text-amber-700 border border-amber-200 font-bold rounded-md flex items-center space-x-1">
            <span>🔥 热门精选</span>
          </span>
        )}
        {isVideo && (
          <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 font-bold rounded-md flex items-center space-x-1 animate-pulse">
            <span>🎬 {isPdf ? '含微课视频+课件' : '含高清微课视频'}</span>
          </span>
        )}
        <span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 font-medium rounded-md">
          🟢 存活可用
        </span>
      </div>

      <!-- 核心标题：直观、易读、可跳转 -->
      <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors leading-snug">
        <a href={`/resource/${slug}`} class="hover:underline">
          {title}
        </a>
      </h3>

      <!-- 描述特色副标题 -->
      {subtitle && (
        <p class="text-xs sm:text-sm text-slate-500 line-clamp-2 leading-relaxed">
          {subtitle}
        </p>
      )}

      <!-- 规格与社会认同数据 -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-1 text-xs text-slate-400 font-mono">
        <span class="text-slate-600 font-medium flex items-center gap-1">
          <span>💾</span> 大小：<strong class="text-slate-700 font-semibold">{fileSize}</strong>
        </span>
        <span class="text-slate-600 font-medium flex items-center gap-1">
          <span>{isVideo ? '🎬' : '📄'}</span> 规格：<strong class="text-slate-700 font-semibold">
            {isVideo ? (pageCount > 0 ? `${pageCount} 讲视频课` : '全套高清视频课') : (pageCount > 100 ? `${pageCount}+ 套` : `${pageCount} 页可打印`)}
          </strong>
        </span>
        <span class="hidden sm:inline-flex items-center gap-1">
          <span>👁️</span> {viewCount} 次查阅
        </span>
        <span class="text-blue-600 font-semibold flex items-center gap-1">
          <span>⚡</span> {saveCount} 人已极速转存
        </span>
        {hasBaidu && (
          <span class="hidden md:inline-flex px-1.5 py-0.2 bg-slate-100 text-slate-600 rounded text-[11px]">
            📦 包含百度网盘备用
          </span>
        )}
      </div>
    </div>
  </div>

  <!-- 右侧：直达转化行动区 (桌面端垂直居中对齐；移动端作为独立底座卡片条，柔和淡雅不喧宾夺主) -->
  <div class="px-4 py-3 sm:px-5 sm:py-5 bg-slate-50/80 sm:bg-transparent border-t border-slate-100 sm:border-0 flex sm:flex-row lg:flex-col items-stretch lg:items-end justify-end gap-2 flex-shrink-0">
    <a
      href={primaryLink.share_url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-save-quark flex-1 lg:flex-initial py-2 px-3.5 sm:px-4 text-xs font-semibold rounded-xl flex items-center justify-center space-x-1.5 whitespace-nowrap shadow-2xs"
      title="直接在新窗口打开夸克网盘极速转存"
    >
      <span class="text-amber-500 text-xs leading-none">⚡</span>
      <span>夸克极速转存</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>

    <div class="flex items-center gap-1.5 flex-1 lg:flex-initial">
      <a
        href={`/resource/${slug}`}
        class="flex-1 py-2 px-3 sm:px-3.5 text-xs font-medium text-slate-600 bg-slate-100/90 hover:bg-slate-200/90 hover:text-slate-900 border border-slate-200/60 rounded-xl transition text-center whitespace-nowrap shadow-2xs sm:shadow-none"
      >
        试看详情 ➔
      </a>
      <button
        type="button"
        class="btn-quick-share p-2 text-slate-400 hover:text-blue-600 bg-slate-100/90 hover:bg-blue-50 border border-slate-200/60 hover:border-blue-200 rounded-xl transition text-center shadow-2xs sm:shadow-none shrink-0 cursor-pointer flex items-center justify-center"
        title="复制推荐语与直达链接分享给好友/家长群"
        data-title={title}
        data-url={`/resource/${slug}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
      </button>
    </div>
  </div>
</article>
