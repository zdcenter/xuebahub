{
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/resource/([^/]+)/?$",
      "dest": "/resource/$1/index.html"
    },
    {
      "src": "^/(book|primary|junior|senior|cert|exam)/?$",
      "dest": "/$1/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
